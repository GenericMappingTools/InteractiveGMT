<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>Xyz2GrdDialog</class>
 <widget class="QDialog" name="Xyz2GrdDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>460</width>
    <height>560</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>xyz2grd</string>
  </property>
  <!--
    The "Griding Line Geometry" group below is the verbatim copy of deps/ui/grid_line_geometry.ui
    (object names xMin/xMax/xInc/xN/yMin/yMax/yInc/yN/refEdit/refBtn/helpBtn kept EXACTLY), which is
    the canonical source to copy from. The C++ side does NOT re-wire it by hand: GeoGridGeometry
    ::adopt(dlg) takes these very widgets over, so the dim-fun cross-recompute and the Ref-grid
    picker are the same single implementation grdsample's code-built block uses.
  -->
  <layout class="QVBoxLayout" name="mainVerticalLayout">
   <property name="spacing">
    <number>8</number>
   </property>
   <property name="margin" stdset="0">
    <number>8</number>
   </property>
   <item>
    <widget class="QLabel" name="lb_hint">
     <property name="text"><string>The table's points must already sit ON the nodes of the region and increment below. To interpolate scattered data instead, use GMT &gt; Interpolate.</string></property>
     <property name="wordWrap"><bool>true</bool></property>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_input">
     <property name="title">
      <string>Input table</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_input">
      <item row="0" column="0" colspan="3">
       <widget class="QLineEdit" name="edit_infile">
        <property name="toolTip"><string>Table with x, y, z columns (or one column, see Z below). Double-click to browse.</string></property>
       </widget>
      </item>
      <item row="0" column="3">
       <widget class="QToolButton" name="btn_infile">
        <property name="text"><string>...</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lb_headers"><property name="text"><string>Header lines</string></property></widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="edit_headers">
        <property name="toolTip"><string>Number of header lines to skip (h) [0]</string></property>
       </widget>
      </item>
      <item row="1" column="2">
       <widget class="QLabel" name="lb_incols"><property name="text"><string>Columns</string></property></widget>
      </item>
      <item row="1" column="3">
       <widget class="QLineEdit" name="edit_incols">
        <property name="toolTip"><string>Which input columns to read as x,y,z (i), e.g. 0,1,3. Empty = the first three.</string></property>
       </widget>
      </item>
      <item row="2" column="0" colspan="2">
       <widget class="QCheckBox" name="chk_toggle">
        <property name="toolTip"><string>The file's first two columns are y,x instead of x,y</string></property>
        <property name="text"><string>File is y,x,z</string></property>
       </widget>
      </item>
      <item row="2" column="2">
       <widget class="QLabel" name="lb_zflags"><property name="text"><string>One column (Z)</string></property></widget>
      </item>
      <item row="2" column="3">
       <widget class="QLineEdit" name="edit_zflags">
        <property name="toolTip"><string>Read a bare one-column table of z values in the node order given by these flags (Z), e.g. TLa. The manual page (the green ? disk) lists them all. Empty = a normal x,y,z table.</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="geoGroup">
     <property name="title"><string>Griding Line Geometry (R, I)</string></property>
     <layout class="QGridLayout" name="geoLayout">
      <property name="horizontalSpacing"><number>8</number></property>
      <property name="verticalSpacing"><number>4</number></property>
      <item row="0" column="1"><widget class="QLabel" name="minLab"><property name="alignment"><set>Qt::AlignHCenter</set></property><property name="text"><string>Min</string></property></widget></item>
      <item row="0" column="2"><widget class="QLabel" name="maxLab"><property name="alignment"><set>Qt::AlignHCenter</set></property><property name="text"><string>Max</string></property></widget></item>
      <item row="0" column="3"><widget class="QLabel" name="spacingLab"><property name="alignment"><set>Qt::AlignHCenter</set></property><property name="text"><string>Spacing</string></property></widget></item>
      <item row="0" column="4"><widget class="QLabel" name="nLinesLab"><property name="alignment"><set>Qt::AlignHCenter</set></property><property name="text"><string># of lines</string></property></widget></item>

      <item row="1" column="0"><widget class="QLabel" name="xDirLab"><property name="text"><string>X Direction</string></property></widget></item>
      <item row="1" column="1"><widget class="QLineEdit" name="xMin"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property></widget></item>
      <item row="1" column="2"><widget class="QLineEdit" name="xMax"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property></widget></item>
      <item row="1" column="3"><widget class="QLineEdit" name="xInc"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property></widget></item>
      <item row="1" column="4"><widget class="QLineEdit" name="xN"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property></widget></item>

      <item row="2" column="0"><widget class="QLabel" name="yDirLab"><property name="text"><string>Y Direction</string></property></widget></item>
      <item row="2" column="1"><widget class="QLineEdit" name="yMin"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property></widget></item>
      <item row="2" column="2"><widget class="QLineEdit" name="yMax"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property></widget></item>
      <item row="2" column="3"><widget class="QLineEdit" name="yInc"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property></widget></item>
      <item row="2" column="4"><widget class="QLineEdit" name="yN"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property></widget></item>

      <item row="1" column="5" rowspan="2">
       <widget class="QToolButton" name="helpBtn">
        <property name="text"><string>?</string></property>
        <property name="toolTip"><string>Edit any two of Min/Max/Spacing/# and the rest are derived.</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="refRow">
     <item><widget class="QLabel" name="refLab"><property name="text"><string>OR Ref grid</string></property></widget></item>
     <item>
      <widget class="QLineEdit" name="refEdit">
       <property name="toolTip"><string>Pick a grid/image; its region, spacing and size fill the boxes above.</string></property>
      </widget>
     </item>
     <item><widget class="QToolButton" name="refBtn"><property name="text"><string>...</string></property></widget></item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_opts">
     <item>
      <widget class="QLabel" name="lb_amode"><property name="text"><string>Several values on one node</string></property></widget>
     </item>
     <item>
      <widget class="QComboBox" name="cb_amode">
       <property name="toolTip"><string>What to keep when more than one record lands on the same node (A)</string></property>
      </widget>
     </item>
     <item>
      <widget class="QCheckBox" name="chk_pixel">
       <property name="toolTip"><string>Pixel registration instead of gridline registration (r)</string></property>
       <property name="text"><string>Pixel registration</string></property>
      </widget>
     </item>
     <item>
      <widget class="QCheckBox" name="chk_geog">
       <property name="toolTip"><string>The nodes are longitude/latitude</string></property>
       <property name="text"><string>Geographic</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_header">
     <property name="title">
      <string>Grid header (D)</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_header">
      <item row="0" column="0">
       <widget class="QLabel" name="lb_dxname"><property name="text"><string>x name</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="edit_dxname"/>
      </item>
      <item row="0" column="2">
       <widget class="QLabel" name="lb_dyname"><property name="text"><string>y name</string></property></widget>
      </item>
      <item row="0" column="3">
       <widget class="QLineEdit" name="edit_dyname"/>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lb_dzname"><property name="text"><string>z name</string></property></widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="edit_dzname">
        <property name="toolTip"><string>What the grid's values are, e.g. "elevation (m)"</string></property>
       </widget>
      </item>
      <item row="1" column="2">
       <widget class="QLabel" name="lb_dtitle"><property name="text"><string>title</string></property></widget>
      </item>
      <item row="1" column="3">
       <widget class="QLineEdit" name="edit_dtitle"/>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="lb_dremark"><property name="text"><string>remark</string></property></widget>
      </item>
      <item row="2" column="1" colspan="3">
       <widget class="QLineEdit" name="edit_dremark">
        <property name="toolTip"><string>Free text stored in the grid's header</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_out">
     <item>
      <widget class="QLabel" name="lb_out"><property name="text"><string>Save grid to</string></property></widget>
     </item>
     <item>
      <widget class="QLineEdit" name="edit_outfile">
       <property name="toolTip"><string>Optional output grid file. Leave empty to keep the new grid only in this window.</string></property>
      </widget>
     </item>
     <item>
      <widget class="QToolButton" name="btn_outfile">
       <property name="text"><string>...</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <spacer name="verticalSpacer_bottom">
     <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
     <property name="sizeType"><enum>QSizePolicy::Policy::Fixed</enum></property>
     <property name="sizeHint" stdset="0"><size><width>20</width><height>6</height></size></property>
    </spacer>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_buttons">
     <item>
      <spacer name="buttonsSpacer">
       <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="push_compute">
       <property name="minimumSize"><size><width>90</width><height>24</height></size></property>
       <property name="text"><string>Make grid</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="push_close">
       <property name="minimumSize"><size><width>70</width><height>24</height></size></property>
       <property name="text"><string>Close</string></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
