   <widget class="QLabel" name="lbl_classes">
    <property name="geometry">
     <rect>
      <x>11</x>
      <y>91</y>
      <width>85</width>
      <height>26</height>
     </rect>
    </property>
    <property name="text">
     <string>Class separators</string>
    </property>
   </widget>
   <widget class="QLineEdit" name="p_classes">
    <property name="geometry">
     <rect>
      <x>102</x>
      <y>91</y>
      <width>325</width>
      <height>26</height>
     </rect>
    </property>
    <property name="toolTip">
     <string>Used only by the Classes output (greyed otherwise). Up to 3 values, comma-separated, increasing: index ≥ 1st = class 1, ≥ 2nd = class 2, ≥ 3rd = class 3, below the 1st = class 0. E.g. NDVI 0.2, 0.4, 0.6 = bare / sparse / moderate / dense vegetation.</string>
    </property>
    <property name="text">
     <string>0.2, 0.4, 0.6</string>
    </property>
   </widget>
