<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>GrdFFTDialog</class>
 <widget class="QDialog" name="GrdFFTDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>480</width>
    <height>640</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>grdfft</string>
  </property>
  <layout class="QVBoxLayout" name="mainVerticalLayout">
   <property name="spacing">
    <number>8</number>
   </property>
   <property name="margin" stdset="0">
    <number>8</number>
   </property>
   <item>
    <widget class="QGroupBox" name="gb_mode">
     <property name="title">
      <string>What to compute</string>
     </property>
     <layout class="QHBoxLayout" name="horizontalLayout_mode">
      <item>
       <widget class="QRadioButton" name="rb_grid">
        <property name="toolTip"><string>Transform the grid, operate in the frequency domain and transform back</string></property>
        <property name="text"><string>A transformed grid</string></property>
        <property name="checked"><bool>true</bool></property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="rb_spectrum">
        <property name="toolTip"><string>Estimate the power spectrum (E). No grid is produced.</string></property>
        <property name="text"><string>A power spectrum</string></property>
       </widget>
      </item>
      <item>
       <spacer name="horizontalSpacer_mode">
        <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
        <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
       </spacer>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_ops">
     <property name="title">
      <string>Frequency-domain operations</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_ops">
      <item row="0" column="0">
       <widget class="QLabel" name="lb_azim"><property name="text"><string>Derivative in azimuth (deg)</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="edit_azim">
        <property name="toolTip"><string>Directional derivative in this azimuth, degrees CW from north (A). Empty = not used.</string></property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QLabel" name="lb_upward"><property name="text"><string>Continue (m)</string></property></widget>
      </item>
      <item row="0" column="3">
       <widget class="QLineEdit" name="edit_upward">
        <property name="toolTip"><string>Upward continue this many meters, or downward with a negative value (C). Empty = not used.</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QCheckBox" name="chk_dfdz">
        <property name="toolTip"><string>Differentiate the field, d(field)/dz (D)</string></property>
        <property name="text"><string>Differentiate d/dz</string></property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="edit_dfdz">
        <property name="toolTip"><string>Optional scale, or the letter g: the data are geoid heights in m and the result is gravity in mGal</string></property>
       </widget>
      </item>
      <item row="1" column="2">
       <widget class="QCheckBox" name="chk_integrate">
        <property name="toolTip"><string>Integrate the field over z (I)</string></property>
        <property name="text"><string>Integrate over z</string></property>
       </widget>
      </item>
      <item row="1" column="3">
       <widget class="QLineEdit" name="edit_integrate">
        <property name="toolTip"><string>Optional scale, or the letter g: the data are gravity anomalies in mGal and the result is geoid height in m</string></property>
       </widget>
      </item>
      <item row="2" column="0" colspan="2">
       <widget class="QCheckBox" name="chk_noop">
        <property name="toolTip"><string>No wavenumber operation at all (Q) — for writing out the FFT's own intermediate products with the modifiers below</string></property>
        <property name="text"><string>No wavenumber operation</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_filter">
     <property name="title">
      <string>Filter (F)</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_filter">
      <item row="0" column="0">
       <widget class="QLabel" name="lb_ftype"><property name="text"><string>Type</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="cb_ftype">
        <property name="toolTip"><string>Band-pass filter shape. The wavelengths are in the grid's own units (meters, or degrees converted with Geographic).</string></property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QLabel" name="lb_fdir"><property name="text"><string>Direction</string></property></widget>
      </item>
      <item row="0" column="3">
       <widget class="QComboBox" name="cb_fdir">
        <property name="toolTip"><string>Filter isotropically, or along x or y only</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lb_f1"><property name="text"><string>lc</string></property></widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="edit_f1"/>
      </item>
      <item row="1" column="2">
       <widget class="QLabel" name="lb_f2"><property name="text"><string>lp</string></property></widget>
      </item>
      <item row="1" column="3">
       <widget class="QLineEdit" name="edit_f2"/>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="lb_f3"><property name="text"><string>hp</string></property></widget>
      </item>
      <item row="2" column="1">
       <widget class="QLineEdit" name="edit_f3"/>
      </item>
      <item row="2" column="2">
       <widget class="QLabel" name="lb_f4"><property name="text"><string>hc</string></property></widget>
      </item>
      <item row="2" column="3">
       <widget class="QLineEdit" name="edit_f4"/>
      </item>
      <item row="3" column="0" colspan="4">
       <widget class="QLabel" name="lb_fhint">
        <property name="text"><string>Leave a box empty for a high- or low-pass filter.</string></property>
        <property name="wordWrap"><bool>true</bool></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_spec">
     <property name="title">
      <string>Power spectrum (E)</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_spec">
      <item row="0" column="0">
       <widget class="QLabel" name="lb_edir"><property name="text"><string>Direction</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="cb_edir">
        <property name="toolTip"><string>Radial spectrum, or along x or y</string></property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QCheckBox" name="chk_ewave">
        <property name="toolTip"><string>Report wavelength instead of frequency (+w)</string></property>
        <property name="text"><string>Wavelength</string></property>
       </widget>
      </item>
      <item row="0" column="3">
       <widget class="QCheckBox" name="chk_ekm">
        <property name="toolTip"><string>Wavelength in km instead of m (+wk); geographic grids only</string></property>
        <property name="text"><string>in km</string></property>
       </widget>
      </item>
      <item row="1" column="0" colspan="2">
       <widget class="QCheckBox" name="chk_enorm">
        <property name="toolTip"><string>Report the mean spectral value per frequency instead of the sum (+n)</string></property>
        <property name="text"><string>Normalize</string></property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="lb_grid2"><property name="text"><string>Second grid</string></property></widget>
      </item>
      <item row="2" column="1" colspan="2">
       <widget class="QLineEdit" name="edit_grid2">
        <property name="toolTip"><string>Optional: with a second grid over the same region the result is the 17-column cross-spectrum (X/Y power, coherent and noise power, phase, admittance, gain, coherency). Double-click to browse.</string></property>
       </widget>
      </item>
      <item row="2" column="3">
       <widget class="QToolButton" name="btn_grid2">
        <property name="text"><string>...</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_fft">
     <property name="title">
      <string>FFT (N)</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_fft">
      <item row="0" column="0">
       <widget class="QLabel" name="lb_fftdim"><property name="text"><string>Dimensions</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="cb_fftdim">
        <property name="toolTip"><string>How the FFT grid size is chosen. The default balances speed and accuracy.</string></property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QLineEdit" name="edit_fftdims">
        <property name="toolTip"><string>nx/ny of the FFT array, only for "given below". Must be &gt;= the grid size.</string></property>
       </widget>
      </item>
      <item row="0" column="3">
       <widget class="QCheckBox" name="chk_fftverbose">
        <property name="toolTip"><string>Report the dimensions actually used (+v)</string></property>
        <property name="text"><string>Report</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lb_detrend"><property name="text"><string>Detrend</string></property></widget>
      </item>
      <item row="1" column="1">
       <widget class="QComboBox" name="cb_detrend">
        <property name="toolTip"><string>What is removed before the FFT</string></property>
       </widget>
      </item>
      <item row="1" column="2">
       <widget class="QComboBox" name="cb_extend">
        <property name="toolTip"><string>How the grid is extended to the FFT size before tapering</string></property>
       </widget>
      </item>
      <item row="1" column="3">
       <widget class="QLineEdit" name="edit_taper">
        <property name="toolTip"><string>Taper width in percent of the margin [100]</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_misc">
     <item>
      <widget class="QLabel" name="lb_scale"><property name="text"><string>Scale (S)</string></property></widget>
     </item>
     <item>
      <widget class="QLineEdit" name="edit_scale">
       <property name="toolTip"><string>Multiply the result by this factor in the space domain, or give d to turn a deflection of the vertical into micro-radians</string></property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="lb_mgal"><property name="text"><string>Gravity at 45 deg (M)</string></property></widget>
     </item>
     <item>
      <widget class="QLineEdit" name="edit_mgal45">
       <property name="toolTip"><string>Gravity in mGal at 45 degrees latitude, used for the geoid conversions [980619.9203, Earth]. Change it for another planet.</string></property>
      </widget>
     </item>
     <item>
      <widget class="QCheckBox" name="chk_geog">
       <property name="toolTip"><string>Grid is in degrees: convert to meters with a "Flat Earth" approximation (-fg)</string></property>
       <property name="text"><string>Geographic</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_out">
     <item>
      <widget class="QLabel" name="lb_out"><property name="text"><string>Save result to</string></property></widget>
     </item>
     <item>
      <widget class="QLineEdit" name="edit_outfile">
       <property name="toolTip"><string>Optional output file: a grid, or a table for the spectrum. Leave empty to keep the result only in this window.</string></property>
      </widget>
     </item>
     <item>
      <widget class="QToolButton" name="btn_outfile">
       <property name="text"><string>...</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <spacer name="verticalSpacer_bottom">
     <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
     <property name="sizeType"><enum>QSizePolicy::Policy::Fixed</enum></property>
     <property name="sizeHint" stdset="0"><size><width>20</width><height>6</height></size></property>
    </spacer>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_buttons">
     <item>
      <spacer name="buttonsSpacer">
       <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="push_compute">
       <property name="minimumSize"><size><width>90</width><height>24</height></size></property>
       <property name="text"><string>Compute</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="push_close">
       <property name="minimumSize"><size><width>70</width><height>24</height></size></property>
       <property name="text"><string>Close</string></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
