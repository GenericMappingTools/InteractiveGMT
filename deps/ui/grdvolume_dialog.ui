<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>GrdVolumeDialog</class>
 <widget class="QDialog" name="GrdVolumeDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>450</width>
    <height>500</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>grdvolume</string>
  </property>
  <layout class="QVBoxLayout" name="mainVerticalLayout">
   <property name="spacing">
    <number>8</number>
   </property>
   <property name="margin" stdset="0">
    <number>8</number>
   </property>
   <item>
    <widget class="QGroupBox" name="gb_contour">
     <property name="title">
      <string>What to measure (C)</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_contour">
      <item row="0" column="0" colspan="4">
       <widget class="QComboBox" name="cb_cmode">
        <property name="toolTip"><string>Which volume the module reports</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lb_cval"><property name="text"><string>Contour</string></property></widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="edit_cval">
        <property name="toolTip"><string>The single contour level to measure against</string></property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="lb_clow"><property name="text"><string>From</string></property></widget>
      </item>
      <item row="2" column="1">
       <widget class="QLineEdit" name="edit_clow">
        <property name="toolTip"><string>The first (lower) contour level</string></property>
       </widget>
      </item>
      <item row="2" column="2">
       <widget class="QLabel" name="lb_chigh"><property name="text"><string>to</string></property></widget>
      </item>
      <item row="2" column="3">
       <widget class="QLineEdit" name="edit_chigh">
        <property name="toolTip"><string>The last (upper) contour level</string></property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="lb_cdelta"><property name="text"><string>Step</string></property></widget>
      </item>
      <item row="3" column="1">
       <widget class="QLineEdit" name="edit_cdelta">
        <property name="toolTip"><string>Contour interval for the scan</string></property>
       </widget>
      </item>
      <item row="3" column="2" colspan="2">
       <widget class="QCheckBox" name="chk_slices">
        <property name="toolTip"><string>Measure each horizontal SLICE between consecutive contours (D) instead of everything above each one. Needs a range.</string></property>
        <property name="text"><string>Slice by slice</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_opts">
     <property name="title">
      <string>Options</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_opts">
      <item row="0" column="0">
       <widget class="QLabel" name="lb_base"><property name="text"><string>Base level (L)</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="edit_base">
        <property name="toolTip"><string>Also add the volume from the contour down to this level. Empty = measure from the contour itself.</string></property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QLabel" name="lb_unit"><property name="text"><string>Distance unit (S)</string></property></widget>
      </item>
      <item row="0" column="3">
       <widget class="QComboBox" name="cb_unit">
        <property name="toolTip"><string>For geographic grids: the horizontal unit areas and volumes are expressed in</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lb_tmax"><property name="text"><string>Best contour (T)</string></property></widget>
      </item>
      <item row="1" column="1" colspan="3">
       <widget class="QComboBox" name="cb_tmax">
        <property name="toolTip"><string>Also report the single contour that maximizes the mean height, or the curvature of height versus contour (the Optimal Robust Separator)</string></property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="lb_zfact"><property name="text"><string>Scale z by (Z)</string></property></widget>
      </item>
      <item row="2" column="1">
       <widget class="QLineEdit" name="edit_zfact">
        <property name="toolTip"><string>Multiply the grid values by this before measuring. Empty = no scaling.</string></property>
       </widget>
      </item>
      <item row="2" column="2">
       <widget class="QLabel" name="lb_zshift"><property name="text"><string>after subtracting</string></property></widget>
      </item>
      <item row="2" column="3">
       <widget class="QLineEdit" name="edit_zshift">
        <property name="toolTip"><string>Subtracted BEFORE the scaling. The contour and base levels refer to the scaled values.</string></property>
       </widget>
      </item>
      <item row="3" column="0" colspan="4">
       <widget class="QCheckBox" name="chk_plot">
        <property name="toolTip"><string>With a range of contours, also draw area, volume and mean height against the contour level in the X,Y plot tool</string></property>
        <property name="text"><string>Plot the curves (a range of contours only)</string></property>
        <property name="checked"><bool>true</bool></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_region">
     <property name="title">
      <string>Region (R)</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_region">
      <item row="0" column="0">
       <widget class="QLabel" name="lb_xmin"><property name="text"><string>xmin</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="edit_xmin"/>
      </item>
      <item row="0" column="2">
       <widget class="QLabel" name="lb_xmax"><property name="text"><string>xmax</string></property></widget>
      </item>
      <item row="0" column="3">
       <widget class="QLineEdit" name="edit_xmax"/>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lb_ymin"><property name="text"><string>ymin</string></property></widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="edit_ymin"/>
      </item>
      <item row="1" column="2">
       <widget class="QLabel" name="lb_ymax"><property name="text"><string>ymax</string></property></widget>
      </item>
      <item row="1" column="3">
       <widget class="QLineEdit" name="edit_ymax"/>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_out">
     <item>
      <widget class="QLabel" name="lb_out"><property name="text"><string>Save table to</string></property></widget>
     </item>
     <item>
      <widget class="QLineEdit" name="edit_outfile">
       <property name="toolTip"><string>Optional table to write the result to. Leave empty to keep it only in this window's Data Viewer.</string></property>
      </widget>
     </item>
     <item>
      <widget class="QToolButton" name="btn_outfile">
       <property name="text"><string>...</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <spacer name="verticalSpacer_bottom">
     <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
     <property name="sizeType"><enum>QSizePolicy::Policy::Fixed</enum></property>
     <property name="sizeHint" stdset="0"><size><width>20</width><height>6</height></size></property>
    </spacer>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_buttons">
     <item>
      <spacer name="buttonsSpacer">
       <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="push_compute">
       <property name="minimumSize"><size><width>90</width><height>24</height></size></property>
       <property name="text"><string>Compute</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="push_close">
       <property name="minimumSize"><size><width>70</width><height>24</height></size></property>
       <property name="text"><string>Close</string></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
