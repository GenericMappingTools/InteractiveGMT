     <widget class="QComboBox" name="p_granule">
      <property name="geometry"><rect><x>70</x><y>27</y><width>264</width><height>26</height></rect></property>
      <property name="toolTip"><string>The scenes found, newest first: date, satellite (LC08, LC09, LE07, LT05...), WRS-2 path/row and cloud cover. "(on disk)": the whole product is already in the folder below. Choosing one highlights its footprint in the view and shows its browse picture.</string></property>
      <property name="refresh" stdset="0"><bool>true</bool></property>
     </widget>
     <widget class="QLabel" name="lbl_folder">
      <property name="geometry"><rect><x>11</x><y>59</y><width>55</width><height>26</height></rect></property>
      <property name="text"><string>Folder</string></property>
     </widget>
     <widget class="QLineEdit" name="p_folder">
      <property name="geometry"><rect><x>70</x><y>59</y><width>264</width><height>26</height></rect></property>
      <property name="toolTip"><string>Where everything is downloaded to (made if it does not exist): a whole scene (USGS: its .tar; Planetary Computer: all its files, in the scene's sub-folder), single bands in a sub-folder named for the scene, browse pictures in "quicklooks". A file already there is not downloaded again.</string></property>
     </widget>
     <widget class="QPushButton" name="run_download">
      <property name="geometry"><rect><x>11</x><y>91</y><width>323</width><height>26</height></rect></property>
      <property name="toolTip"><string>Download the WHOLE chosen scene (every band plus its metadata) into the folder. Planetary Computer: every file, one by one, no account. USGS: the .tar, with the login of the Account tab.</string></property>
      <property name="text"><string>Download the whole scene</string></property>
      <property name="busy" stdset="0"><string>Downloading the Landsat scene…</string></property>
     </widget>
    </widget>
    <widget class="QLabel" name="lbl_dn">
     <property name="geometry"><rect><x>11</x><y>481</y><width>333</width><height>100</height></rect></property>
     <property name="text"><string>The bands are stored as USGS delivers them, in digital numbers. Level-2: reflectance = DN x 0.0000275 - 0.2; surface temperature (kelvin) = DN x 0.00341802 + 149. Level-1: the MTL file of the whole scene has the factors to radiance and reflectance. QA_PIXEL flags clouds, shadow, water and snow.</string></property>
     <property name="alignment"><set>Qt::AlignmentFlag::AlignLeading|Qt::AlignmentFlag::AlignLeft|Qt::AlignmentFlag::AlignTop</set></property>
     <property name="wordWrap"><bool>true</bool></property>
    </widget>
   </widget>
