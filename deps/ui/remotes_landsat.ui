    <widget class="QGroupBox" name="gb_query">
     <property name="geometry"><rect><x>5</x><y>155</y><width>345</width><height>186</height></rect></property>
     <property name="title"><string>Source, product, period and clouds</string></property>
     <widget class="QLabel" name="lbl_source">
      <property name="geometry"><rect><x>11</x><y>27</y><width>55</width><height>26</height></rect></property>
