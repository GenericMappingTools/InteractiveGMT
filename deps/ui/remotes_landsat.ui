     </widget>
     <widget class="QComboBox" name="p_product">
      <property name="geometry"><rect><x>70</x><y>59</y><width>264</width><height>26</height></rect></property>
      <property name="toolTip"><string>Level-2: surface reflectance (SR bands) and surface temperature (ST band), corrected for the atmosphere by USGS. Level-1: top-of-atmosphere digital numbers, with the 15 m panchromatic band and both thermal bands. A scene is 185 x 180 km, 30 m pixels.</string></property>
      <property name="refresh" stdset="0"><bool>true</bool></property>
     </widget>
