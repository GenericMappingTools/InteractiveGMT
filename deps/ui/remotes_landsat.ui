     <widget class="QComboBox" name="p_source">
      <property name="geometry"><rect><x>70</x><y>27</y><width>264</width><height>26</height></rect></property>
      <property name="toolTip"><string>Microsoft Planetary Computer: USGS's Collection 2 Level-2 files (surface reflectance and temperature, Landsat 4-5, 7, 8-9, the whole globe) with NO account. USGS EarthExplorer: the same archive plus Level-1 and the whole-scene .tar, through its M2M API; needs your ERS user name, an M2M application token, and M2M download access granted by USGS.</string></property>
      <property name="refresh" stdset="0"><bool>true</bool></property>
     </widget>
     <widget class="QLabel" name="lbl_product">
      <property name="geometry"><rect><x>11</x><y>59</y><width>55</width><height>26</height></rect></property>
