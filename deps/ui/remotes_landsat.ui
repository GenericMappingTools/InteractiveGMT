    <property name="toolTip"><string>Download ONLY the region of the Search tab (converted to the scene's own UTM system): GDAL reads just that window of each band's cloud-optimised GeoTIFF over the internet, never the whole file. Unticked: the whole scene is downloaded (about 80 MB per band, 7700 x 7800 pixels).</string></property>
    <property name="text"><string>Cut to the region</string></property>
