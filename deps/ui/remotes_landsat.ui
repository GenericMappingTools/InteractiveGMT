     <widget class="QSpinBox" name="p_cloud">
      <property name="geometry"><rect><x>70</x><y>121</y><width>70</width><height>24</height></rect></property>
      <property name="toolTip"><string>The largest cloud cover accepted, in percent of the whole scene (the scene's own cloud cover, not over your region). 100: every scene.</string></property>
      <property name="suffix"><string> %</string></property>
      <property name="minimum"><number>0</number></property>
      <property name="maximum"><number>100</number></property>
      <property name="value"><number>30</number></property>
     </widget>
     <widget class="QLabel" name="lbl_cloud_hint">
      <property name="geometry"><rect><x>150</x><y>121</y><width>184</width><height>24</height></rect></property>
      <property name="text"><string>at most, of the whole scene</string></property>
     </widget>
     <widget class="QPushButton" name="run_search">
      <property name="geometry"><rect><x>11</x><y>153</y><width>156</width><height>26</height></rect></property>
      <property name="toolTip"><string>Ask the source for the scenes of the product over the region in the period, with at most that cloud cover, newest first, and draw their footprints (on an empty window, over a map with coastlines made for them). Then click inside a footprint in the view to choose its scene; clicking the same place again steps to the next scene covering it. A new search replaces the previous footprints.</string></property>
      <property name="text"><string>Find the scenes</string></property>
      <property name="busy" stdset="0"><string>Finding the Landsat scenes over the region…</string></property>
     </widget>
     <widget class="QPushButton" name="run_stack">
      <property name="geometry"><rect><x>178</x><y>153</y><width>156</width><height>26</height></rect></property>
      <property name="toolTip"><string>Show the browse picture of every scene found, each laid on the ground it covers, stacked one level per pass (the rows of one path on one day side by side; oldest at the bottom, newest on top), the parts with no data see-through, in a 3-D view of the window. Drag the knob of the axis on the map's upper-left corner to hide the levels above it; click a picture to choose its scene. Press again after a new search to rebuild the stack.</string></property>
      <property name="text"><string>Quicklooks 3-D</string></property>
      <property name="busy" stdset="0"><string>Stacking the browse pictures…</string></property>
     </widget>
    </widget>
