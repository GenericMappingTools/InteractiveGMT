          <item>
           <widget class="QLineEdit" name="edit_minNpts">
            <property name="maximumSize"><size><width>60</width><height>16777215</height></size></property>
            <property name="text"><string>0</string></property>
            <property name="toolTip"><string>Do not plot contours with less than this number of vertex.</string></property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <widget class="QPushButton" name="push_GuessIntervals">
          <property name="text"><string>Add Common Charting Intervals</string></property>
          <property name="toolTip"><string>Fill the list with round elevation intervals spanning the grid's range</string></property>
