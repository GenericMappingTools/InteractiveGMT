           </widget>
          </item>
          <item>
           <widget class="QLabel" name="lb_max"><property name="text"><string>Max:</string></property></widget>
          </item>
          <item>
           <widget class="QLineEdit" name="edit_Zmax">
            <property name="readOnly"><bool>true</bool></property>
            <property name="toolTip"><string>Maximum z of the grid being contoured</string></property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <layout class="QHBoxLayout" name="horizontalLayout_opts">
          <item>
           <widget class="QCheckBox" name="check_plotLabels">
            <property name="text"><string>Plot Labels</string></property>
            <property name="toolTip"><string>Annotate each contour line with its elevation</string></property>
            <property name="checked"><bool>true</bool></property>
