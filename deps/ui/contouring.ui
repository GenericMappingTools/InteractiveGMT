   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_top">
     <item>
      <widget class="QGroupBox" name="gb_range">
       <property name="title">
        <string>Elevation Range:</string>
       </property>
       <layout class="QVBoxLayout" name="verticalLayout_left">
        <item>
