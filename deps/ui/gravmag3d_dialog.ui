<?xml version="1.0" encoding="UTF-8"?>
<!--
  gravmag3d_dialog.ui — Geophysics > Magnetics > "gmtgravmag3d".
  Loaded at RUNTIME by GravMag3DDialog (deps/src/70_window.cpp) via QUiLoader, so it may only use
  plain Qt widget classes (no promoted/custom widgets). Every control maps 1:1 onto a GMT.jl
  `gravmag3d` keyword — the option letter is in each label so the mapping stays obvious:
    Body tab   : M|body (geometric bodies), Tv|index, Tr|raw_triang, Ts|stl, Q|onebased, noswap
    Anomaly tab: C|density (gravity)  XOR  H|mag_params (magnetic) — mutually exclusive in GMT
    Output tab : R|region, I|inc, L|z_obs, Z|level, E|thickness, S|radius, F|track, G|save
-->
<ui version="4.0">
 <class>GravMag3DDialog</class>
 <widget class="QDialog" name="GravMag3DDialog">
  <property name="windowTitle">
   <string>gmtgravmag3d</string>
  </property>
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>470</width>
    <height>390</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout_main">
   <property name="spacing">
    <number>4</number>
   </property>
   <item>
    <widget class="QTabWidget" name="tabWidget">
     <property name="currentIndex">
      <number>0</number>
     </property>

     <!-- ===================== TAB: Body ===================== -->
     <widget class="QWidget" name="tab_body">
      <attribute name="title">
       <string>Body</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_body">
       <property name="spacing">
        <number>4</number>
       </property>

       <item>
        <widget class="QRadioButton" name="rb_geomBody">
         <property name="text">
          <string>Geometric body(s)   (M | body)</string>
         </property>
         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_geom">
         <item>
          <widget class="QComboBox" name="cb_shape">
           <item>
            <property name="text">
             <string>prism</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>sphere</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>ellipsoid</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>cylinder</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>cone</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>pyramid</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>bell</string>
            </property>
           </item>
          </widget>
         </item>
         <item>
          <widget class="QLineEdit" name="le_bodyParams">
           <property name="toolTip">
            <string>Slash-separated parameters of the selected shape. Depths are positive UP, so a body below the surface has a negative z.</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QToolButton" name="btn_addBody">
           <property name="text">
            <string>Add</string>
           </property>
           <property name="toolTip">
            <string>Add this shape to the body list. More than one body can be piled up (they all share the same density / magnetic parameters).</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_bodyList">
         <item>
          <widget class="QListWidget" name="list_bodies">
           <property name="maximumHeight">
            <number>68</number>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QToolButton" name="btn_delBody">
           <property name="text">
            <string>Del</string>
           </property>
           <property name="toolTip">
            <string>Remove the selected body from the list</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>

       <item>
        <widget class="QRadioButton" name="rb_file">
         <property name="text">
          <string>Surface/triangles from file</string>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_file">
         <item>
          <widget class="QComboBox" name="cb_fileKind">
           <property name="toolTip">
            <string>Which -T flavour the file is</string>
           </property>
           <item>
            <property name="text">
             <string>raw triangles (Tr)</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>index/vertex (Tv)</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>STL (Ts)</string>
            </property>
           </item>
          </widget>
         </item>
         <item>
          <widget class="QLineEdit" name="le_bodyFile">
           <property name="enabled">
            <bool>false</bool>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QToolButton" name="btn_bodyFileBrowse">
           <property name="enabled">
            <bool>false</bool>
           </property>
           <property name="text">
            <string>...</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>

       <item>
        <widget class="QRadioButton" name="rb_memFV">
         <property name="text">
          <string>3-D solid already in this window</string>
         </property>
         <property name="toolTip">
          <string>Use the triangulated solid (GMTfv) loaded in this window. Bodies made of quadrangles (e.g. cube) are not accepted by gravmag3d.</string>
         </property>
        </widget>
       </item>

       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_flags">
         <item>
          <widget class="QCheckBox" name="chk_onebased">
           <property name="text">
            <string>1-based indices  (Q)</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="chk_noswap">
           <property name="text">
            <string>Facets are clockwise  (noswap)</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="horizontalSpacer_flags">
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>10</width>
             <height>10</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </item>

       <item>
        <spacer name="verticalSpacer_body">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>10</width>
           <height>4</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>

     <!-- ===================== TAB: Anomaly ===================== -->
     <widget class="QWidget" name="tab_anomaly">
