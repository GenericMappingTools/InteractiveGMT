         </item>
         <item row="1" column="1">
          <widget class="QLineEdit" name="le_thickness">
           <property name="toolTip">
            <string>Only for a NON-closed surface whose constant-thickness layer anomaly you want</string>
           </property>
          </widget>
         </item>
         <item row="1" column="2">
          <widget class="QLabel" name="lbl_radius">
           <property name="text">
            <string>Search radius, km  (S)</string>
           </property>
          </widget>
         </item>
         <item row="1" column="3">
          <widget class="QLineEdit" name="le_radius">
           <property name="toolTip">
            <string>Valid only in two-grids mode or together with a layer thickness [30 km]</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>

       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_track">
         <item>
          <widget class="QLabel" name="lbl_track">
           <property name="text">
            <string>Track  (F)</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLineEdit" name="le_track">
           <property name="toolTip">
            <string>x,y file with the locations where the anomaly is computed. Mutually exclusive with a grid output — the result comes back as a table.</string>
