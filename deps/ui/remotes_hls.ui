   <widget class="QSpinBox" name="p_minclear">
    <property name="geometry">
     <rect>
      <x>347</x>
      <y>123</y>
      <width>80</width>
      <height>24</height>
     </rect>
    </property>
    <property name="toolTip">
     <string>A date is kept only if at least this share of the region's pixels is clear in its Fmask (no cirrus, cloud, cloud-adjacent, shadow or snow). Masked pixels are NaN in the grids.</string>
    </property>
    <property name="maximum">
     <number>100</number>
    </property>
    <property name="value">
     <number>80</number>
    </property>
   </widget>
