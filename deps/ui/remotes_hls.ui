   </widget>
   <widget class="QComboBox" name="p_products">
    <property name="geometry">
     <rect>
      <x>55</x>
      <y>91</y>
      <width>372</width>
      <height>26</height>
     </rect>
    </property>
    <property name="toolTip">
     <string>HLS is one 30 m grid for both satellites, band-adjusted so their dates mix in one series. Both together give a date every 2-3 days. The last entry is Sentinel-2 at its own resolution (10 m for indices of blue, green, red and NIR; 20 m for those with red-edge or SWIR), from Element84's Earth Search on AWS: no login needed, no Landsat mixed in.</string>
    </property>
    <property name="refresh" stdset="0">
     <bool>true</bool>
    </property>
    <item>
     <property name="text">
      <string>Landsat 8/9 and Sentinel-2 (L30 + S30)</string>
     </property>
    </item>
    <item>
     <property name="text">
      <string>Landsat 8/9 only (L30)</string>
     </property>
    </item>
    <item>
     <property name="text">
      <string>Sentinel-2 only (S30)</string>
     </property>
    </item>
    <item>
     <property name="text">
      <string>Sentinel-2 L2A, 10 m (Earth Search, no login)</string>
     </property>
    </item>
   </widget>
