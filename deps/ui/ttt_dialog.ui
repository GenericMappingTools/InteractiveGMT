      </item>
      <item row="1" column="0">
       <widget class="QCheckBox" name="chk_search">
        <property name="text">
         <string>Move source to water</string>
        </property>
        <property name="toolTip">
         <string>Relocate a source that falls on land to the nearest water node.</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="edit_radius">
        <property name="toolTip">
