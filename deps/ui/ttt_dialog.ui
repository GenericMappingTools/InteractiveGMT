    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="group_method">
     <property name="title">
      <string>Method</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayout_method">
      <item>
       <widget class="QRadioButton" name="rb_ttt">
        <property name="text">
         <string>Wessel ttt — Huygens wavefront (accurate, slower)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="rb_mirone">
        <property name="text">
         <string>Mirone wavefront expansion (fast)</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="group_ttt">
     <property name="title">
      <string>ttt options</string>
