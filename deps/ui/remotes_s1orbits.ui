    <property name="toolTip">
     <string>Precise orbits (POEORB) are what InSAR wants; they are published about 20 days after the acquisition. Until then only the restituted ones (RESORB, a few hours after) exist. The first choice takes the precise orbit where there is one and the restituted one otherwise.</string>
    </property>
   </widget>
