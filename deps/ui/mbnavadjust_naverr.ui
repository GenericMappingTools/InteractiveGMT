<?xml version="1.0" encoding="UTF-8"?>
<!--
  mbnavadjust_naverr.ui - the crossing / section analysis window of the navigation adjustment tool
  (mbnavadjust's bulletinBoard_naverr, mbnavadjust_creation.c). Loaded at runtime by
  src/mbnavadjust/mbnavadjust_window.cpp. Absolute geometry from the Motif bulletin board, no
  layouts. The three drawing areas are plain widgets the window paints into: the two sections'
  contours (drawingArea_naverr_cont, 600 x 600), the misfit grid (drawingArea_naverr_corr,
  301 x 301) and the z offset misfit (drawingArea_naverr_zcorr, 300 x 60), as the uil sizes them.
  "Settings" opens the Biases and Contours dialogs, as the Motif menu bar of the same name did.
-->
<ui version="4.0">
