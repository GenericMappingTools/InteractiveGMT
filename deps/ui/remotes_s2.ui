        <y>121</y>
        <width>156</width>
        <height>26</height>
       </rect>
      </property>
      <property name="toolTip">
       <string>Show the quicklook of every scene found, each laid on its own tile, stacked one level per pass (all tiles of one pass side by side; oldest at the bottom, newest on top), the parts with no data see-through, in a 3-D view of the window. Click a quicklook to choose its scene. Press again after a new search to rebuild the stack.</string>
      </property>
      <property name="text">
       <string>Quicklooks 3-D</string>
