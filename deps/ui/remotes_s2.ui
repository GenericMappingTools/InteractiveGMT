     <widget class="QPushButton" name="run_search">
      <property name="geometry">
       <rect>
        <x>11</x>
        <y>121</y>
        <width>156</width>
        <height>26</height>
       </rect>
      </property>
      <property name="toolTip">
       <string>Ask the Copernicus Data Space catalogue (no login needed) for the scenes of the product over the region in the period, with at most that cloud cover, newest first, and draw their footprints (on an empty window, over a map with coastlines made for them). Then click inside a footprint in the view to choose its scene; clicking the same place again steps to the next scene covering it. A new search replaces the previous footprints.</string>
      </property>
      <property name="text">
       <string>Find the scenes</string>
      </property>
      <property name="busy" stdset="0">
       <string>Finding the Sentinel-2 scenes over the region…</string>
      </property>
     </widget>
