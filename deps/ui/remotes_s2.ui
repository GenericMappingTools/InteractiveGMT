     <widget class="QComboBox" name="p_product">
      <property name="geometry">
       <rect>
        <x>70</x>
        <y>27</y>
        <width>264</width>
        <height>26</height>
       </rect>
      </property>
      <property name="toolTip">
       <string>L2A: surface reflectance, corrected for the atmosphere by ESA (Sen2Cor), with a scene classification band (SCL: cloud, shadow, water, snow...) and bands at 10, 20 and 60 m. L1C: top-of-atmosphere reflectance, every band only at its own spacing (B02 B03 B04 B08 10 m; B05 B06 B07 B8A B11 B12 20 m; B01 B09 B10 60 m). A tile is 110 x 110 km, about 0.5 to 1.2 GB as a whole product.</string>
      </property>
      <property name="refresh" stdset="0">
       <bool>true</bool>
      </property>
     </widget>
