<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>Talwani2DDialog</class>
 <widget class="QDialog" name="Talwani2DDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>470</width>
    <height>560</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>talwani2d</string>
  </property>
  <layout class="QVBoxLayout" name="mainVerticalLayout">
   <property name="spacing">
    <number>8</number>
   </property>
   <property name="margin" stdset="0">
    <number>8</number>
   </property>
   <item>
    <widget class="QLabel" name="lb_hint">
     <property name="text"><string>Anomalies over 2-D bodies given as cross-section polygons (x, z), one body per segment, with that body's density in the segment header.</string></property>
     <property name="wordWrap"><bool>true</bool></property>
    </widget>
   </item>
   <item>
    <layout class="QGridLayout" name="gridLayout_model">
     <item row="0" column="0">
      <widget class="QLabel" name="lb_infile"><property name="text"><string>Model file</string></property></widget>
     </item>
     <item row="0" column="1">
      <widget class="QLineEdit" name="edit_infile">
       <property name="toolTip"><string>The cross-sections of one or more bodies, one polygon per segment. Double-click to browse.</string></property>
      </widget>
     </item>
     <item row="0" column="2">
      <widget class="QToolButton" name="btn_infile">
       <property name="text"><string>...</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_field">
     <property name="title">
      <string>Field and model</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_field">
      <item row="0" column="0">
       <widget class="QLabel" name="lb_field"><property name="text"><string>Compute</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="cb_field">
        <property name="toolTip"><string>Which geopotential field to model (F)</string></property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QLabel" name="lb_lat"><property name="text"><string>at lat</string></property></widget>
      </item>
      <item row="0" column="3">
       <widget class="QLineEdit" name="edit_lat">
        <property name="toolTip"><string>Latitude at which normal gravity is evaluated for the geoid [45]. Geoid only.</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lb_density"><property name="text"><string>Density (D)</string></property></widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="edit_density">
        <property name="toolTip"><string>One density contrast for every body, overriding the segment headers. Below 10 is read as g/cm3, above as kg/m3. Empty = take each body's density from its own segment header.</string></property>
       </widget>
      </item>
      <item row="1" column="2" colspan="2">
       <widget class="QCheckBox" name="chk_zup">
        <property name="toolTip"><string>The z-axis of the model points UP (A) [default is down]</string></property>
        <property name="text"><string>z is positive up</string></property>
       </widget>
      </item>
      <item row="2" column="0" colspan="2">
       <widget class="QCheckBox" name="chk_hkm">
        <property name="toolTip"><string>Horizontal distances in the model are in km (Mh) [metres]</string></property>
        <property name="text"><string>x distances in km</string></property>
       </widget>
      </item>
      <item row="2" column="2" colspan="2">
       <widget class="QCheckBox" name="chk_vkm">
        <property name="toolTip"><string>Vertical distances in the model are in km (Mv) [metres]</string></property>
        <property name="text"><string>z distances in km</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_lattice">
     <property name="title">
      <string>Where to compute</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_where">
      <item row="0" column="0" colspan="4">
       <widget class="QRadioButton" name="rb_lattice">
        <property name="toolTip"><string>An equidistant profile (T)</string></property>
        <property name="text"><string>On an equidistant profile</string></property>
        <property name="checked"><bool>true</bool></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lb_tmin"><property name="text"><string>From x</string></property></widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="edit_tmin"/>
      </item>
      <item row="1" column="2">
       <widget class="QLabel" name="lb_tmax"><property name="text"><string>to</string></property></widget>
      </item>
      <item row="1" column="3">
       <widget class="QLineEdit" name="edit_tmax"/>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="lb_tinc"><property name="text"><string>Step</string></property></widget>
      </item>
      <item row="2" column="1">
       <widget class="QLineEdit" name="edit_tinc"/>
      </item>
      <item row="2" column="2" colspan="2">
       <widget class="QCheckBox" name="chk_tnum">
        <property name="toolTip"><string>Read that box as the NUMBER of points along the profile instead of the step (+n)</string></property>
        <property name="text"><string>is a point count</string></property>
       </widget>
      </item>
      <item row="3" column="0" colspan="4">
       <widget class="QRadioButton" name="rb_track">
        <property name="toolTip"><string>Compute at the locations listed in a file instead (N)</string></property>
        <property name="text"><string>At the locations in a file</string></property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="lb_trackfile"><property name="text"><string>Locations</string></property></widget>
      </item>
      <item row="4" column="1" colspan="2">
       <widget class="QLineEdit" name="edit_trackfile">
        <property name="toolTip"><string>A file of x [z] positions. A second column is taken as the observation level unless one is given below. Double-click to browse.</string></property>
       </widget>
      </item>
      <item row="4" column="3">
       <widget class="QToolButton" name="btn_trackfile">
        <property name="text"><string>...</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_level">
     <property name="title">
      <string>Observation level (Z)</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_level">
      <item row="0" column="0">
       <widget class="QLabel" name="lb_level"><property name="text"><string>Level</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="edit_level">
        <property name="toolTip"><string>A constant observation level [0]</string></property>
       </widget>
      </item>
      <item row="0" column="2" colspan="2">
       <widget class="QLabel" name="lb_25hint">
        <property name="text"><string>2.5-D: finite along strike</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lb_y25min"><property name="text"><string>From y</string></property></widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="edit_y25min">
        <property name="toolTip"><string>Near end of the body's extent along strike. Free-air anomalies only; empty = a truly 2-D body.</string></property>
       </widget>
      </item>
      <item row="1" column="2">
       <widget class="QLabel" name="lb_y25max"><property name="text"><string>to</string></property></widget>
      </item>
      <item row="1" column="3">
       <widget class="QLineEdit" name="edit_y25max">
        <property name="toolTip"><string>Far end of the body's extent along strike. Free-air anomalies only.</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QGridLayout" name="gridLayout_out">
     <item row="0" column="0">
      <widget class="QLabel" name="lb_out"><property name="text"><string>Save profile to</string></property></widget>
     </item>
     <item row="0" column="1">
      <widget class="QLineEdit" name="edit_outfile">
       <property name="toolTip"><string>Optional output table. The profile always goes to the Data Viewer.</string></property>
      </widget>
     </item>
     <item row="0" column="2">
      <widget class="QToolButton" name="btn_outfile">
       <property name="text"><string>...</string></property>
      </widget>
     </item>
     <item row="1" column="0" colspan="3">
      <widget class="QCheckBox" name="chk_plot">
       <property name="toolTip"><string>Also draw the modelled anomaly in the X,Y plot tool</string></property>
       <property name="text"><string>Plot the profile</string></property>
       <property name="checked"><bool>true</bool></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <spacer name="verticalSpacer_bottom">
     <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
     <property name="sizeType"><enum>QSizePolicy::Policy::Fixed</enum></property>
     <property name="sizeHint" stdset="0"><size><width>20</width><height>6</height></size></property>
    </spacer>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_buttons">
     <item>
      <spacer name="buttonsSpacer">
       <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="push_compute">
       <property name="minimumSize"><size><width>90</width><height>24</height></size></property>
       <property name="text"><string>Compute</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="push_close">
       <property name="minimumSize"><size><width>70</width><height>24</height></size></property>
       <property name="text"><string>Close</string></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
