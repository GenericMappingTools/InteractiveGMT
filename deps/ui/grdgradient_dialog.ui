            <string>?</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_norm">
         <item>
          <widget class="QLabel" name="lbl_norm">
           <property name="text">
            <string>Normalization</string>
           </property>
