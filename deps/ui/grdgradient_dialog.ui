<?xml version="1.0" encoding="UTF-8"?>
<!--
  grdgradient_dialog.ui — GMT menu > "grdgradient".
  Tab 1 "Gradient" is Mirone's own grdgradient window, control for control (Azim1/Azim2 lists in a
  "Horizontal Light Angles" box, the Slope/Aspect checkboxes with the direction-flavour combo, the
  Boundary condition and Normalization rows) plus its small blue "?" notes. Mirone's window predates
  a good part of today's module, so tabs 2 and 3 carry what it never had: the Lambertian radiance
  family (E), an azimuth GRID, the -Da down-slope flavour, region, the normalization statistics file
  (Q) and a save-to-disk name (G).
  Loaded at RUNTIME by GrdGradientDialog via QUiLoader — plain Qt widget classes only.
-->
<ui version="4.0">
 <class>GrdGradientDialog</class>
 <widget class="QDialog" name="GrdGradientDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>586</width>
    <height>270</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>grdgradient</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout_main">
   <property name="spacing">
    <number>6</number>
   </property>
   <item>
    <widget class="QTabWidget" name="tabWidget">
     <property name="currentIndex">
      <number>0</number>
     </property>

     <!-- ==================== TAB: Gradient (Mirone's window) ==================== -->
     <widget class="QWidget" name="tab_gradient">
      <attribute name="title">
       <string>Gradient</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_grad">
       <property name="spacing">
        <number>6</number>
       </property>
       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_top">
         <item>
          <widget class="QGroupBox" name="gb_light">
           <property name="maximumHeight">
            <number>132</number>
           </property>
           <property name="title">
            <string>Horizontal Light Angles</string>
           </property>
           <layout class="QHBoxLayout" name="horizontalLayout_light">
            <property name="spacing">
             <number>4</number>
            </property>
            <item>
             <widget class="QLabel" name="lbl_azim1">
              <property name="text">
               <string>Azim1</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QListWidget" name="list_azim1">
              <property name="maximumHeight">
               <number>96</number>
              </property>
              <property name="toolTip">
               <string>Azimuth of the light source, degrees clockwise from north</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="lbl_azim2">
              <property name="text">
               <string>Azim2</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QListWidget" name="list_azim2">
              <property name="maximumHeight">
               <number>96</number>
              </property>
              <property name="toolTip">
               <string>Optional second azimuth: both gradients are computed and the larger in magnitude is kept</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QToolButton" name="btn_helpLight">
              <property name="text">
               <string>?</string>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>
         <item>
          <widget class="QGroupBox" name="gb_direction">
           <property name="title">
            <string/>
           </property>
           <layout class="QHBoxLayout" name="horizontalLayout_dirBox">
            <property name="spacing">
             <number>4</number>
            </property>
            <item>
             <layout class="QVBoxLayout" name="verticalLayout_dir">
              <property name="spacing">
               <number>6</number>
              </property>
              <item>
               <widget class="QCheckBox" name="chk_slope">
                <property name="text">
                 <string>Compute Slope (percent)</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="chk_aspect">
                <property name="text">
                 <string>Gradient direction (Aspect)</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QComboBox" name="cb_dirFlavour">
                <property name="enabled">
                 <bool>false</bool>
                </property>
                <item>
                 <property name="text">
                  <string>azimuthal direction</string>
                 </property>
                </item>
                <item>
                 <property name="text">
                  <string>trignometric angles</string>
                 </property>
                </item>
                <item>
                 <property name="text">
                  <string>0-180 degrees orientations</string>
                 </property>
                </item>
                <item>
                 <property name="text">
                  <string>add 90 degrees to all angles</string>
                 </property>
                </item>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="chk_downSlope">
                <property name="enabled">
                 <bool>false</bool>
                </property>
                <property name="text">
                 <string>report down-slope (aspect)</string>
                </property>
                <property name="toolTip">
                 <string>-Da: the aspect, i.e. the DOWN-slope direction. Unticked, the module reports the up-slope one.</string>
                </property>
               </widget>
              </item>
             </layout>
            </item>
            <item>
             <widget class="QToolButton" name="btn_helpDir">
              <property name="text">
               <string>?</string>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>
        </layout>
       </item>
