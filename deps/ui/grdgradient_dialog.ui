          <widget class="QLabel" name="lbl_lambView">
           <property name="text">
            <string>Light vector:   azimuth</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLineEdit" name="le_lambAzim">
           <property name="enabled">
