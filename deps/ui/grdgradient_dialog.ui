     <!-- ==================== TAB: Lambertian (E) ==================== -->
     <widget class="QWidget" name="tab_lambert">
      <attribute name="title">
       <string>Lambertian</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_lamb">
       <property name="spacing">
        <number>4</number>
       </property>
       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_lambMode">
         <item>
          <widget class="QLabel" name="lbl_lambert">
           <property name="text">
            <string>Radiance  (E)</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QComboBox" name="cb_lambert">
           <property name="toolTip">
            <string>Lambertian radiance, for use with grdimage/grdview. Overrides the Gradient tab.</string>
