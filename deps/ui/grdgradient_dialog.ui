         </item>
         <item row="0" column="4">
          <widget class="QLineEdit" name="le_ymax">
           <property name="toolTip">
            <string>ymax</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_stats">
         <item>
          <widget class="QLabel" name="lbl_saveStats">
           <property name="text">
            <string>Normalization statistics  (Q)</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QComboBox" name="cb_saveStats">
           <property name="toolTip">
            <string>Reuse one offset/sigma across several grids or tiles: save them once, then read them back on later runs.</string>
           </property>
           <item>
            <property name="text">
             <string>(recompute for this grid)</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>save to the statistics file</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>read from the statistics file</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>read, then delete the file</string>
            </property>
           </item>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_outfile">
         <item>
          <widget class="QLabel" name="lbl_outfile">
           <property name="text">
            <string>Save as  (G)</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLineEdit" name="le_outfile">
           <property name="toolTip">
            <string>Optional. The result is always added to this window; give a name here to also write it to disk.</string>
