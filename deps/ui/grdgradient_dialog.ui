     <!-- ==================== TAB: Output ==================== -->
     <widget class="QWidget" name="tab_output">
      <attribute name="title">
       <string>Output</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_out">
       <property name="spacing">
        <number>4</number>
       </property>
       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_azimGrid">
         <item>
          <widget class="QLabel" name="lbl_azimGrid">
           <property name="text">
            <string>Azimuth from grid  (A)</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLineEdit" name="le_azimGrid">
           <property name="toolTip">
            <string>A grid of the same domain, spacing and registration as the input: the azimuth is then updated at every node. Overrides Azim1/Azim2.</string>
