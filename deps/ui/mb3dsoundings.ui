<?xml version="1.0" encoding="UTF-8"?>
<!--
  mb3dsoundings.ui - mbeditviz's 3-D sounding editor (MB-System's libmbview mb3dsoundings, the
  Mb3dsdg widget). Loaded at RUNTIME by deps/src/mbeditviz/mb3dsoundings_window.cpp (QUiLoader);
  every objectName is looked up by name there. Each bias slider has its <name>Value label.
-->
<ui version="4.0">
 <class>Mb3dSoundingsWindow</class>
 <widget class="QMainWindow" name="Mb3dSoundingsWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1040</width><height>600</height></rect>
  </property>
  <property name="windowTitle">
   <string>3D Soundings</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="mainLayout">
    <property name="spacing"><number>4</number></property>
    <property name="leftMargin"><number>6</number></property>
    <property name="topMargin"><number>4</number></property>
    <property name="rightMargin"><number>6</number></property>
    <property name="bottomMargin"><number>4</number></property>
    <item>
     <layout class="QHBoxLayout" name="bodyRow">
      <item>
       <layout class="QVBoxLayout" name="controlColumn">
        <item>
         <widget class="QRadioButton" name="modeToggle">
          <property name="toolTip"><string>Left click toggles the sounding nearest the pointer (key Q)</string></property>
          <property name="text"><string>Toggle</string></property>
          <property name="checked"><bool>true</bool></property>
         </widget>
        </item>
        <item>
         <widget class="QRadioButton" name="modePick">
          <property name="toolTip"><string>Left click flags the good sounding nearest the pointer (key W)</string></property>
          <property name="text"><string>Pick</string></property>
         </widget>
        </item>
        <item>
         <widget class="QRadioButton" name="modeErase">
          <property name="toolTip"><string>Left drag flags every good sounding it sweeps over (key E)</string></property>
          <property name="text"><string>Erase</string></property>
         </widget>
        </item>
        <item>
         <widget class="QRadioButton" name="modeRestore">
          <property name="toolTip"><string>Left drag unflags every flagged sounding it sweeps over (key R)</string></property>
          <property name="text"><string>Restore</string></property>
         </widget>
        </item>
        <item>
         <widget class="QRadioButton" name="modeGrab">
          <property name="toolTip"><string>Left drag a rectangle: every good sounding inside it is flagged (key T)</string></property>
          <property name="text"><string>Grab</string></property>
         </widget>
        </item>
        <item>
         <widget class="QRadioButton" name="modeInfo">
          <property name="toolTip"><string>Left click shows the file, ping, beam and values of the nearest sounding (key Y)</string></property>
          <property name="text"><string>Info</string></property>
         </widget>
        </item>
        <item>
         <spacer name="modeSpacer">
          <property name="orientation"><enum>Qt::Vertical</enum></property>
          <property name="sizeType"><enum>QSizePolicy::Fixed</enum></property>
          <property name="sizeHint" stdset="0"><size><width>10</width><height>12</height></size></property>
         </spacer>
        </item>
        <item>
         <widget class="QPushButton" name="resetButton">
          <property name="text"><string>Reset View</string></property>
          <property name="autoDefault"><bool>false</bool></property>
         </widget>
        </item>
        <item>
         <spacer name="controlSpacer">
          <property name="orientation"><enum>Qt::Vertical</enum></property>
          <property name="sizeHint" stdset="0"><size><width>10</width><height>20</height></size></property>
         </spacer>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QWidget" name="canvasHost">
        <property name="sizePolicy">
         <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
          <horstretch>1</horstretch>
          <verstretch>1</verstretch>
         </sizepolicy>
        </property>
        <property name="minimumSize"><size><width>500</width><height>380</height></size></property>
       </widget>
      </item>
     </layout>
    </item>
    <item>
     <widget class="QLabel" name="labelStatus">
      <property name="text"><string>Azimuth: 0.00 | Elevation: 0.00 | Vert. Exager.: 1.00</string></property>
      <property name="textInteractionFlags"><set>Qt::TextSelectableByMouse</set></property>
     </widget>
    </item>
    <item>
     <widget class="QWidget" name="biasPanel">
      <layout class="QGridLayout" name="biasGrid">
       <property name="leftMargin"><number>0</number></property>
       <property name="topMargin"><number>0</number></property>
       <property name="rightMargin"><number>0</number></property>
       <property name="bottomMargin"><number>0</number></property>
       <property name="horizontalSpacing"><number>6</number></property>
       <property name="verticalSpacing"><number>2</number></property>
       <item row="0" column="0">
        <widget class="QLabel" name="rollLabel"><property name="toolTip"><string>Roll offset (degrees) added to the attitude used to place the soundings. Fixes swaths tilted across-track: outer beams too deep on one side and too shallow on the other. Applied on release; the range re-centres when you reach an end. Action &gt; Optimize Bias Values (roll) estimates it.</string></property><property name="text"><string>Roll Bias (degrees)</string></property></widget>
       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="rollSliderValue"><property name="text"><string>0.00</string></property></widget>
       </item>
       <item row="2" column="0">
        <widget class="QSlider" name="rollSlider">
         <property name="toolTip"><string>Roll offset (degrees) added to the attitude used to place the soundings. Fixes swaths tilted across-track: outer beams too deep on one side and too shallow on the other. Applied on release; the range re-centres when you reach an end. Action &gt; Optimize Bias Values (roll) estimates it.</string></property>
         <property name="minimum"><number>-100</number></property>
         <property name="maximum"><number>100</number></property>
         <property name="orientation"><enum>Qt::Horizontal</enum></property>
        </widget>
       </item>
       <item row="0" column="1">
        <widget class="QLabel" name="pitchLabel"><property name="toolTip"><string>Pitch offset (degrees) added to the attitude used to place the soundings. Fixes along-track displacement: the same feature appears shifted fore/aft on lines run in opposite directions. Applied on release; the range re-centres when you reach an end. Action &gt; Optimize Bias Values (pitch) estimates it.</string></property><property name="text"><string>Pitch Bias (degrees)</string></property></widget>
       </item>
       <item row="1" column="1">
        <widget class="QLabel" name="pitchSliderValue"><property name="text"><string>0.00</string></property></widget>
       </item>
       <item row="2" column="1">
        <widget class="QSlider" name="pitchSlider">
         <property name="toolTip"><string>Pitch offset (degrees) added to the attitude used to place the soundings. Fixes along-track displacement: the same feature appears shifted fore/aft on lines run in opposite directions. Applied on release; the range re-centres when you reach an end. Action &gt; Optimize Bias Values (pitch) estimates it.</string></property>
         <property name="minimum"><number>-100</number></property>
         <property name="maximum"><number>100</number></property>
         <property name="orientation"><enum>Qt::Horizontal</enum></property>
        </widget>
       </item>
       <item row="0" column="2">
        <widget class="QLabel" name="headingLabel"><property name="toolTip"><string>Heading (yaw) offset (degrees) added to the ship heading used to place the soundings. Fixes a swath rotated about the vertical: outer-beam features shift in opposite directions on reciprocal lines. Applied on release; the range re-centres when you reach an end. Action &gt; Optimize Bias Values (heading) estimates it.</string></property><property name="text"><string>Heading Bias (degrees)</string></property></widget>
       </item>
       <item row="1" column="2">
        <widget class="QLabel" name="headingSliderValue"><property name="text"><string>0.00</string></property></widget>
       </item>
       <item row="2" column="2">
        <widget class="QSlider" name="headingSlider">
         <property name="toolTip"><string>Heading (yaw) offset (degrees) added to the ship heading used to place the soundings. Fixes a swath rotated about the vertical: outer-beam features shift in opposite directions on reciprocal lines. Applied on release; the range re-centres when you reach an end. Action &gt; Optimize Bias Values (heading) estimates it.</string></property>
         <property name="minimum"><number>-100</number></property>
         <property name="maximum"><number>100</number></property>
         <property name="orientation"><enum>Qt::Horizontal</enum></property>
        </widget>
       </item>
       <item row="0" column="3">
        <widget class="QLabel" name="timelagLabel"><property name="toolTip"><string>Time lag (seconds) between the sonar pings and the navigation/attitude data. Fixes sensor latency: swath edges that ripple in step with the ship roll. Applied on release; the range re-centres when you reach an end. Action &gt; Optimize Time Lag Values estimates it.</string></property><property name="text"><string>Time Lag (seconds)</string></property></widget>
       </item>
       <item row="1" column="3">
        <widget class="QLabel" name="timelagSliderValue"><property name="text"><string>0.00</string></property></widget>
       </item>
       <item row="2" column="3">
        <widget class="QSlider" name="timelagSlider">
         <property name="toolTip"><string>Time lag (seconds) between the sonar pings and the navigation/attitude data. Fixes sensor latency: swath edges that ripple in step with the ship roll. Applied on release; the range re-centres when you reach an end. Action &gt; Optimize Time Lag Values estimates it.</string></property>
         <property name="minimum"><number>-100</number></property>
         <property name="maximum"><number>100</number></property>
         <property name="orientation"><enum>Qt::Horizontal</enum></property>
        </widget>
       </item>
       <item row="0" column="4">
        <widget class="QLabel" name="snellLabel"><property name="toolTip"><string>Scale factor on the sound speed used for ray tracing (1.0000 = unchanged). Fixes refraction errors from a wrong surface sound speed: swaths that curl up (smile) or down (frown) toward the outer beams. Applied on release; the range re-centres when you reach an end. Action &gt; Optimize Snell Correction Values estimates it.</string></property><property name="text"><string>Snell Correction</string></property></widget>
       </item>
       <item row="1" column="4">
        <widget class="QLabel" name="snellSliderValue"><property name="text"><string>1.0000</string></property></widget>
       </item>
       <item row="2" column="4">
        <widget class="QSlider" name="snellSlider">
         <property name="toolTip"><string>Scale factor on the sound speed used for ray tracing (1.0000 = unchanged). Fixes refraction errors from a wrong surface sound speed: swaths that curl up (smile) or down (frown) toward the outer beams. Applied on release; the range re-centres when you reach an end. Action &gt; Optimize Snell Correction Values estimates it.</string></property>
         <property name="minimum"><number>9900</number></property>
         <property name="maximum"><number>10100</number></property>
         <property name="value"><number>10000</number></property>
         <property name="orientation"><enum>Qt::Horizontal</enum></property>
        </widget>
       </item>
      </layout>
     </widget>
    </item>
   </layout>
  </widget>
