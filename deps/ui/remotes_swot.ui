     <widget class="QLabel" name="lbl_product">
      <property name="geometry">
       <rect>
        <x>11</x>
        <y>27</y>
        <width>55</width>
        <height>26</height>
       </rect>
      </property>
      <property name="text">
       <string>Product</string>
