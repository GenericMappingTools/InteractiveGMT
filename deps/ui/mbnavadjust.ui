<?xml version="1.0" encoding="UTF-8"?>
<!--
  mbnavadjust.ui - the navigation adjustment main window (port of MB-System's mbnavadjust,
  mbnavadjust.uil / mbnavadjust_creation.c, CreatemainWindow). Loaded at RUNTIME by
  deps/src/mbnavadjust/mbnavadjust_window.cpp (QUiLoader). The objectNames are the Motif widget
  names; the callbacks (mbnavadjust_callbacks.c) reach every one by name, so rename one and the
  tool refuses to open, naming the missing widget.
  Absolute geometry from the Motif form, no layouts: the list and the message text follow the
  window's size from code, as the Motif form's attachments made them follow it.
-->
<ui version="4.0">
