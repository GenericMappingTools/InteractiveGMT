<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>GrdTrendDialog</class>
 <widget class="QDialog" name="GrdTrendDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>430</width>
    <height>430</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>grdtrend</string>
  </property>
  <layout class="QVBoxLayout" name="mainVerticalLayout">
   <property name="spacing">
    <number>8</number>
   </property>
   <property name="margin" stdset="0">
    <number>8</number>
   </property>
   <item>
    <widget class="QGroupBox" name="gb_what">
     <property name="title">
      <string>What to compute</string>
     </property>
     <layout class="QHBoxLayout" name="horizontalLayout_what">
      <item>
       <widget class="QRadioButton" name="rb_trend">
        <property name="toolTip"><string>The fitted trend surface (-T)</string></property>
        <property name="text"><string>Trend</string></property>
        <property name="checked"><bool>true</bool></property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="rb_residuals">
        <property name="toolTip"><string>Input data minus the trend (-D)</string></property>
        <property name="text"><string>Residuals</string></property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="rb_weights">
        <property name="toolTip"><string>The weights used by the robust fit (-W). Needs Robust Fit.</string></property>
        <property name="text"><string>Weights</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="lb_model">
     <property name="text"><string>Number of model parameters</string></property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_model">
     <item>
      <widget class="QComboBox" name="cb_model">
       <property name="minimumSize"><size><width>70</width><height>0</height></size></property>
       <property name="toolTip"><string>Highest model parameter to fit: 3 = bilinear, 6 = quadratic, 10 = cubic surface</string></property>
      </widget>
     </item>
     <item>
      <widget class="QCheckBox" name="chk_robust">
       <property name="toolTip"><string>Iteratively reweight the data so outliers do not drag the fit (+r)</string></property>
       <property name="text"><string>Robust Fit</string></property>
      </widget>
     </item>
     <item>
      <spacer name="horizontalSpacer_model">
       <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QCheckBox" name="chk_protectNaNs">
       <property name="toolTip"><string>If checked put the NaNs back on the trend surface</string></property>
       <property name="text"><string>Protect NaNs</string></property>
       <property name="checked"><bool>true</bool></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_axis">
     <item>
      <widget class="QLabel" name="lb_axis">
       <property name="text"><string>Fit varies along</string></property>
      </widget>
     </item>
     <item>
      <widget class="QComboBox" name="cb_axis">
       <property name="toolTip"><string>A full surface in x and y, or a 1-D trend along one axis only (+x / +y, model 1-4)</string></property>
      </widget>
     </item>
     <item>
      <spacer name="horizontalSpacer_axis">
       <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_region">
     <property name="title">
      <string>Region (R)</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_region">
      <item row="0" column="0">
       <widget class="QLabel" name="lb_xmin"><property name="text"><string>xmin</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="edit_xmin"/>
      </item>
      <item row="0" column="2">
       <widget class="QLabel" name="lb_xmax"><property name="text"><string>xmax</string></property></widget>
      </item>
      <item row="0" column="3">
       <widget class="QLineEdit" name="edit_xmax"/>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lb_ymin"><property name="text"><string>ymin</string></property></widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="edit_ymin"/>
      </item>
      <item row="1" column="2">
       <widget class="QLabel" name="lb_ymax"><property name="text"><string>ymax</string></property></widget>
      </item>
      <item row="1" column="3">
       <widget class="QLineEdit" name="edit_ymax"/>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_weights">
     <property name="title">
      <string>Weight grid (optional)</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayout_weights">
      <item>
       <layout class="QHBoxLayout" name="horizontalLayout_wfile">
        <item>
         <widget class="QLineEdit" name="edit_wfile">
          <property name="toolTip"><string>Grid of weights for a weighted least-squares fit (-W). Double-click to browse.</string></property>
         </widget>
        </item>
        <item>
         <widget class="QToolButton" name="btn_wfile">
          <property name="text"><string>...</string></property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QCheckBox" name="chk_sigma">
        <property name="toolTip"><string>The grid holds one-sigma uncertainties; weights become 1/sigma^2 (+s)</string></property>
        <property name="text"><string>Values are 1-sigma uncertainties</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_out">
     <item>
      <widget class="QLabel" name="lb_out"><property name="text"><string>Save result to</string></property></widget>
     </item>
     <item>
      <widget class="QLineEdit" name="edit_outfile">
       <property name="toolTip"><string>Optional output grid file. Leave empty to keep the result only in this window.</string></property>
      </widget>
     </item>
     <item>
      <widget class="QToolButton" name="btn_outfile">
       <property name="text"><string>...</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <spacer name="verticalSpacer_bottom">
     <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
     <property name="sizeType"><enum>QSizePolicy::Policy::Fixed</enum></property>
     <property name="sizeHint" stdset="0"><size><width>20</width><height>6</height></size></property>
    </spacer>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_buttons">
     <item>
      <spacer name="buttonsSpacer">
       <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="push_compute">
       <property name="minimumSize"><size><width>90</width><height>24</height></size></property>
       <property name="text"><string>Compute</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="push_close">
       <property name="minimumSize"><size><width>70</width><height>24</height></size></property>
       <property name="text"><string>Close</string></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
