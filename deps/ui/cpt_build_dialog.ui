<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>CptBuildDialog</class>
 <widget class="QDialog" name="CptBuildDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>470</width>
    <height>580</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Make CPT</string>
  </property>
  <layout class="QVBoxLayout" name="mainVerticalLayout">
   <property name="spacing">
    <number>8</number>
   </property>
   <property name="margin" stdset="0">
    <number>8</number>
   </property>
   <item>
    <widget class="QGroupBox" name="gb_mode">
     <property name="title">
      <string>Where the z range comes from</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayout_mode">
      <item>
       <widget class="QRadioButton" name="rb_make">
        <property name="toolTip"><string>makecpt: the range you type below, or the master CPT's own if you leave it empty</string></property>
        <property name="text"><string>The range below (makecpt)</string></property>
        <property name="checked"><bool>true</bool></property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="rb_grd">
        <property name="toolTip"><string>grd2cpt: the data in this window's grid, optionally histogram-equalized</string></property>
        <property name="text"><string>This window's grid (grd2cpt)</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_master">
     <item>
      <widget class="QLabel" name="lb_master"><property name="text"><string>Master CPT</string></property></widget>
     </item>
     <item>
      <widget class="QComboBox" name="cb_master">
       <property name="editable"><bool>true</bool></property>
       <property name="minimumSize"><size><width>180</width><height>0</height></size></property>
       <property name="toolTip"><string>A GMT master CPT name, or the path of a .cpt file. Type any name the list does not carry.</string></property>
      </widget>
     </item>
     <item>
      <widget class="QToolButton" name="btn_master">
       <property name="text"><string>...</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_range">
     <property name="title">
      <string>Range (T)</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_range">
      <item row="0" column="0">
       <widget class="QLabel" name="lb_tmin"><property name="text"><string>min</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="edit_tmin">
        <property name="toolTip"><string>Lowest z of the new CPT. Leave the whole row empty to keep the master's own range.</string></property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QLabel" name="lb_tmax"><property name="text"><string>max</string></property></widget>
      </item>
      <item row="0" column="3">
       <widget class="QLineEdit" name="edit_tmax">
        <property name="toolTip"><string>Highest z of the new CPT</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lb_tinc"><property name="text"><string>interval</string></property></widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="edit_tinc">
        <property name="toolTip"><string>Optional: the slice width, or the number of slice boundaries — see the box on the right</string></property>
       </widget>
      </item>
      <item row="1" column="2" colspan="2">
       <widget class="QComboBox" name="cb_tmod">
        <property name="toolTip"><string>What the interval means</string></property>
       </widget>
      </item>
      <item row="2" column="0" colspan="4">
       <widget class="QPushButton" name="push_fromgrid">
        <property name="toolTip"><string>Fill min and max from this window's grid</string></property>
        <property name="text"><string>Fill from the window's grid</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_grd">
     <property name="title">
      <string>From the grid (grd2cpt)</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_grd">
      <item row="0" column="0">
       <widget class="QLabel" name="lb_nlevels"><property name="text"><string>Levels</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="edit_nlevels">
        <property name="toolTip"><string>Resample the colour table into this many equidistant slices (E). Empty = the module's own histogram-equalized levels.</string></property>
       </widget>
      </item>
      <item row="0" column="2" colspan="2">
       <widget class="QCheckBox" name="chk_cdf">
        <property name="toolTip"><string>Assign levels from the cumulative density function of the data (E+c)</string></property>
        <property name="text"><string>Follow the data's CDF</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lb_lmin"><property name="text"><string>Use data from</string></property></widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="edit_lmin">
        <property name="toolTip"><string>Ignore data below this when building the palette (L). Either limit may be left empty.</string></property>
       </widget>
      </item>
      <item row="1" column="2">
       <widget class="QLabel" name="lb_lmax"><property name="text"><string>to</string></property></widget>
      </item>
      <item row="1" column="3">
       <widget class="QLineEdit" name="edit_lmax">
        <property name="toolTip"><string>Ignore data above this when building the palette (L)</string></property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="lb_symmetric"><property name="text"><string>Symmetric</string></property></widget>
      </item>
      <item row="2" column="1" colspan="3">
       <widget class="QComboBox" name="cb_symmetric">
        <property name="toolTip"><string>Force the table to be symmetric about zero, with the range taken from one end or the other (S)</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_common">
     <property name="title">
      <string>Colours</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_common">
      <item row="0" column="0">
       <widget class="QCheckBox" name="chk_continuous">
        <property name="toolTip"><string>Continuous colour ramp instead of constant colour per slice (Z)</string></property>
        <property name="text"><string>Continuous</string></property>
        <property name="checked"><bool>true</bool></property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QCheckBox" name="chk_log">
        <property name="toolTip"><string>Logarithmic interpolation; the range is given as log10(z) (Q)</string></property>
        <property name="text"><string>Log10</string></property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QLabel" name="lb_invert"><property name="text"><string>Reverse</string></property></widget>
      </item>
      <item row="0" column="3">
       <widget class="QComboBox" name="cb_invert">
        <property name="toolTip"><string>Reverse the colour progression, the z values, or both (I)</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lb_glo"><property name="text"><string>Truncate from</string></property></widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="edit_glo">
        <property name="toolTip"><string>Cut the master CPT so it starts here (G). Either end may be left empty.</string></property>
       </widget>
      </item>
      <item row="1" column="2">
       <widget class="QLabel" name="lb_ghi"><property name="text"><string>to</string></property></widget>
      </item>
      <item row="1" column="3">
       <widget class="QLineEdit" name="edit_ghi">
        <property name="toolTip"><string>Cut the master CPT so it ends here (G)</string></property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="lb_alpha"><property name="text"><string>Transparency %</string></property></widget>
      </item>
      <item row="2" column="1">
       <widget class="QLineEdit" name="edit_alpha">
        <property name="toolTip"><string>One transparency, 0-100, for every colour slice (A)</string></property>
       </widget>
      </item>
      <item row="2" column="2" colspan="2">
       <widget class="QCheckBox" name="chk_alphaall">
        <property name="toolTip"><string>Also make the background, foreground and NaN colours transparent (A+a)</string></property>
        <property name="text"><string>including B/F/NaN</string></property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="lb_bfn"><property name="text"><string>Back/fore/NaN</string></property></widget>
      </item>
      <item row="3" column="1" colspan="3">
       <widget class="QComboBox" name="cb_bfn">
        <property name="toolTip"><string>Where the background, foreground and NaN colours come from (D, M, N)</string></property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="lb_colormodel"><property name="text"><string>Written as</string></property></widget>
      </item>
      <item row="4" column="1">
       <widget class="QComboBox" name="cb_colormodel">
        <property name="toolTip"><string>Colour model of the written CPT (F). Only affects the saved file's text.</string></property>
       </widget>
      </item>
      <item row="4" column="2">
       <widget class="QCheckBox" name="chk_categorical">
        <property name="toolTip"><string>Do not interpolate the master; take its colours in order (W) — for categorical tables</string></property>
        <property name="text"><string>Categorical</string></property>
       </widget>
      </item>
      <item row="4" column="3">
       <widget class="QCheckBox" name="chk_wrap">
        <property name="toolTip"><string>Cyclic table that endlessly repeats its range (Ww)</string></property>
        <property name="text"><string>cyclic</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_apply">
     <item>
      <widget class="QCheckBox" name="chk_apply">
       <property name="toolTip"><string>Recolour the grid this window is showing with the new palette</string></property>
       <property name="text"><string>Apply to the window's grid</string></property>
       <property name="checked"><bool>true</bool></property>
      </widget>
     </item>
     <item>
      <spacer name="horizontalSpacer_apply">
       <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_out">
     <item>
      <widget class="QLabel" name="lb_out"><property name="text"><string>Save CPT to</string></property></widget>
     </item>
     <item>
      <widget class="QLineEdit" name="edit_outfile">
       <property name="toolTip"><string>Optional .cpt file to write the palette to. Leave empty to only apply it here.</string></property>
      </widget>
     </item>
     <item>
      <widget class="QToolButton" name="btn_outfile">
       <property name="text"><string>...</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <spacer name="verticalSpacer_bottom">
     <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
     <property name="sizeType"><enum>QSizePolicy::Policy::Fixed</enum></property>
     <property name="sizeHint" stdset="0"><size><width>20</width><height>6</height></size></property>
    </spacer>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_buttons">
     <item>
      <spacer name="buttonsSpacer">
       <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="push_compute">
       <property name="minimumSize"><size><width>90</width><height>24</height></size></property>
       <property name="text"><string>Make CPT</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="push_close">
       <property name="minimumSize"><size><width>70</width><height>24</height></size></property>
       <property name="text"><string>Close</string></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
