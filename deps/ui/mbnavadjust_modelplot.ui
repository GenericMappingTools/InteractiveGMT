<?xml version="1.0" encoding="UTF-8"?>
<!--
  mbnavadjust_modelplot.ui - View > Show Modelplot of the navigation adjustment tool (mbnavadjust's
  bulletinBoard_modelplot, mbnavadjust_creation.c): the adjustment model as time series, as
  perturbation, or the tie offsets. Loaded at runtime by src/mbnavadjust/mbnavadjust_window.cpp.
  Absolute geometry from the Motif bulletin board, no layouts. The drawing area follows the window's
  size, MBNA_MODELPLOT_LEFT_WIDTH (25) narrower and MBNA_MODELPLOT_LEFT_HEIGHT (65) lower, as
  do_modelplot_resize sizes it.
-->
<ui version="4.0">
 <class>MbNavAdjustModelplot</class>
