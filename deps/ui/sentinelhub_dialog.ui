<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>SentinelHubDialog</class>
 <widget class="QDialog" name="SentinelHubDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>470</width>
    <height>620</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Sentinel Hub</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout_main">
   <item>
    <widget class="QTabWidget" name="tabs">
     <property name="currentIndex">
      <number>0</number>
     </property>
     <widget class="QWidget" name="tab_login">
      <attribute name="title">
       <string>Login</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_login">
       <item>
        <widget class="QLabel" name="lbl_welcome">
         <property name="text">
          <string>&lt;html&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot;font-size:12pt; font-weight:600;&quot;&gt;Copernicus Data Space / Sentinel Hub&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="group_credentials">
         <property name="title">
          <string>OAuth client (leave empty to use ~/.sentinelhub)</string>
         </property>
         <layout class="QGridLayout" name="gridLayout_credentials" columnstretch="0,1">
          <item row="0" column="0">
           <widget class="QLabel" name="lbl_client_id">
            <property name="text">
             <string>Client ID</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QLineEdit" name="edit_client_id">
            <property name="toolTip">
             <string>&lt;html&gt;The OAuth client id created in the Copernicus Data Space user&lt;br&gt;dashboard. Left empty, it is read from ~/.sentinelhub.&lt;/html&gt;</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="lbl_client_secret">
            <property name="text">
             <string>Client secret</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QLineEdit" name="edit_client_secret">
            <property name="echoMode">
             <enum>QLineEdit::Password</enum>
            </property>
            <property name="toolTip">
             <string>&lt;html&gt;The secret of that OAuth client. Left empty, it is read from&lt;br&gt;~/.sentinelhub.&lt;/html&gt;</string>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="lbl_service_url">
            <property name="text">
             <string>Service URL</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QComboBox" name="cb_service_url">
            <property name="editable">
             <bool>true</bool>
            </property>
            <item>
             <property name="text">
              <string>https://sh.dataspace.copernicus.eu</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>https://services.sentinel-hub.com</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>https://services-uswest2.sentinel-hub.com</string>
             </property>
            </item>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QCheckBox" name="chk_savecred">
            <property name="text">
             <string>Remember them in ~/.sentinelhub</string>
            </property>
            <property name="toolTip">
             <string>Writes the two above to ~/.sentinelhub (plain text) so they need not be typed again.</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <layout class="QHBoxLayout" name="horizontalLayout_login_btn">
            <item>
             <spacer name="spacer_login">
              <property name="orientation">
               <enum>Qt::Horizontal</enum>
              </property>
              <property name="sizeHint" stdset="0">
               <size>
                <width>40</width>
                <height>20</height>
               </size>
              </property>
             </spacer>
            </item>
            <item>
             <widget class="QPushButton" name="btn_login">
              <property name="text">
               <string>Login</string>
              </property>
              <property name="toolTip">
               <string>&lt;html&gt;Asks the service for a token with the credentials above (or, if&lt;br&gt;they are empty, with the ones in ~/.sentinelhub) and says whether&lt;br&gt;it was accepted. Ticked above, it writes the file first.&lt;/html&gt;</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QPlainTextEdit" name="txt_login_log">
         <property name="readOnly">
          <bool>true</bool>
         </property>
         <property name="toolTip">
          <string>What the login attempt did.</string>
         </property>
         <property name="plainText">
          <string>Not logged in.</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="lbl_oauth_help">
         <property name="text">
          <string>&lt;html&gt;&lt;body&gt;&lt;p&gt;&lt;a href=&quot;https://documentation.dataspace.copernicus.eu/APIs/SentinelHub/Overview/Authentication.html#registering-oauth-client&quot;&gt;&lt;span style=&quot;text-decoration: underline; color:#0000ff;&quot;&gt;Create OAuth client&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="openExternalLinks">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="lbl_patience">
         <property name="text">
          <string>&lt;html&gt;&lt;body&gt;&lt;p&gt;&lt;b&gt;Be patient with Copernicus.&lt;/b&gt; Registering an account and creating an
OAuth client there is slower and more confusing than it has any right to be: the
instructions are scattered over several pages, the dashboard is not where the
documentation says it is, and the secret is shown &lt;i&gt;once&lt;/i&gt; &amp;mdash; copy it
immediately. None of that is iGMT talking to you; it is the service. Allow
yourself a quiet quarter of an hour the first time. What to do with the
credentials once you have them is in &lt;b&gt;Usage tutorial&lt;/b&gt;, at the bottom of
this dialog.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="spacer_login_bottom">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tab_image">
      <attribute name="title">
