<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>GadmDialog</class>
 <widget class="QDialog" name="GadmDialog">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>460</width><height>230</height></rect>
  </property>
  <property name="windowTitle">
   <string>GADM administrative units</string>
  </property>
  <layout class="QVBoxLayout" name="mainVerticalLayout">
   <property name="spacing"><number>8</number></property>
   <property name="margin" stdset="0"><number>8</number></property>
   <item>
    <widget class="QGroupBox" name="gb_what">
     <property name="title"><string>Which unit</string></property>
     <layout class="QGridLayout" name="gridLayout_what" columnstretch="0,1,0">
      <item row="0" column="0">
       <widget class="QLabel" name="lb_country"><property name="text"><string>Country</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="cb_country">
        <property name="toolTip"><string>The country, by name and ISO 3166 alpha-3 code. The first use of one downloads its GADM file into ~/.gmt/cache, which takes a while. Type to jump to a name.</string></property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QPushButton" name="push_list">
        <property name="minimumSize"><size><width>120</width><height>24</height></size></property>
        <property name="text"><string>List subregions</string></property>
        <property name="toolTip"><string>Print the names of the administrative children of what is filled in above (the country, or the last subregion). Double-click a name to add it.</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lb_subs"><property name="text"><string>Subregions</string></property></widget>
      </item>
      <item row="1" column="1" colspan="2">
       <widget class="QLineEdit" name="edit_subs">
        <property name="toolTip"><string>Optional, in hierarchical order and comma separated: province, then district, … e.g. "Cabo Delgado". Leave empty for the whole country.</string></property>
       </widget>
      </item>
      <item row="2" column="1" colspan="2">
       <widget class="QCheckBox" name="chk_children">
        <property name="text"><string>Plot all its children (the next administrative level)</string></property>
        <property name="toolTip"><string>gadm(..., children=true): the boundaries of every subregion of what was asked for, instead of just its own outline.</string></property>
       </widget>
      </item>
      <item row="3" column="1" colspan="2">
       <widget class="QCheckBox" name="chk_grand">
        <property name="text"><string>…and the level below that (grandchildren)</string></property>
        <property name="toolTip"><string>The children of each child: a country's districts rather than its provinces. Every one of them is fetched, so it takes longer than the level above.</string></property>
       </widget>
      </item>
      <item row="4" column="1" colspan="2">
       <widget class="QCheckBox" name="chk_all">
        <property name="text"><string>Plot every level BELOW the chosen unit</string></property>
        <property name="toolTip"><string>Every administrative level under what is selected above: for a country, its provinces AND their districts AND their parishes, down to the deepest level that country has.</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <spacer name="verticalSpacer_bottom">
     <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
     <property name="sizeType"><enum>QSizePolicy::Policy::Fixed</enum></property>
     <property name="sizeHint" stdset="0"><size><width>20</width><height>6</height></size></property>
    </spacer>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_buttons">
     <item>
      <spacer name="buttonsSpacer">
       <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="push_plot">
       <property name="minimumSize"><size><width>90</width><height>24</height></size></property>
       <property name="text"><string>Plot</string></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
