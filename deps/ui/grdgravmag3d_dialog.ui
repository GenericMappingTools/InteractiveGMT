     <!-- ===================== TAB: Output ===================== -->
     <widget class="QWidget" name="tab_output">
      <attribute name="title">
       <string>Output</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_out">
       <property name="spacing">
        <number>4</number>
       </property>

       <item>
        <layout class="QGridLayout" name="gridLayout_region">
         <item row="0" column="0">
          <widget class="QLabel" name="lbl_region">
           <property name="text">
            <string>Region  (R)</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QLineEdit" name="le_xmin">
           <property name="toolTip">
            <string>xmin — leave the four boxes empty to use the top grid's own region</string>
           </property>
          </widget>
         </item>
         <item row="0" column="2">
          <widget class="QLineEdit" name="le_xmax">
           <property name="toolTip">
            <string>xmax</string>
           </property>
          </widget>
         </item>
         <item row="0" column="3">
          <widget class="QLineEdit" name="le_ymin">
           <property name="toolTip">
            <string>ymin</string>
           </property>
          </widget>
         </item>
         <item row="0" column="4">
          <widget class="QLineEdit" name="le_ymax">
           <property name="toolTip">
            <string>ymax</string>
           </property>
          </widget>
         </item>
         <item row="1" column="0">
          <widget class="QLabel" name="lbl_inc">
           <property name="text">
            <string>Increment  (I)</string>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <widget class="QLineEdit" name="le_xinc">
           <property name="toolTip">
            <string>x_inc — empty means the input grid's own increment</string>
           </property>
          </widget>
         </item>
         <item row="1" column="2">
          <widget class="QLineEdit" name="le_yinc">
           <property name="toolTip">
            <string>y_inc — leave empty to reuse x_inc</string>
           </property>
          </widget>
         </item>
         <item row="1" column="3" colspan="2">
          <widget class="QCheckBox" name="chk_geog">
           <property name="text">
            <string>Geographic (f=:g)</string>
           </property>
           <property name="toolTip">
            <string>Convert lon/lat to meters with a Flat Earth approximation</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>

       <item>
        <layout class="QGridLayout" name="gridLayout_misc">
         <item row="0" column="0">
