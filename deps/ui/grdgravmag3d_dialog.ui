         <item row="0" column="3">
          <widget class="QComboBox" name="cb_igrf">
           <property name="enabled">
            <bool>false</bool>
           </property>
           <property name="toolTip">
            <string>Over a large region the ambient field is not constant: -H+i / -H+n take the inclination/declination from IGRF at each node</string>
