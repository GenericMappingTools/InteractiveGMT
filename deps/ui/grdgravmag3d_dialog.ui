<?xml version="1.0" encoding="UTF-8"?>
<!--
  grdgravmag3d_dialog.ui — Geophysics > Magnetics > "grdgravmag3d". Loaded at RUNTIME by
  GrdGravMag3DDialog (deps/src/70_window.cpp) via QUiLoader, so plain Qt widget classes only.
  Every control maps 1:1 onto a GMT.jl `grdgravmag3d` keyword, option letter shown in the label:
    Grids tab  : grd_top (+ optional grd_bot), E|thickness, Z|level (b|t), Q|pad
    Anomaly tab: C|density (gravity)  XOR  H|mag_params (magnetic: the 5 angles, a component, an
                 intensity grid via +m, and/or IGRF-variable field via +i/+n — GMT takes several
                 -H at once, which is why these are separate controls and not one box)
    Output tab : R|region, I|inc, L|z_obs, S|radius, F|track, G|save, f=:g, x (threads)
-->
<ui version="4.0">
 <class>GrdGravMag3DDialog</class>
 <widget class="QDialog" name="GrdGravMag3DDialog">
  <property name="windowTitle">
   <string>grdgravmag3d</string>
  </property>
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>480</width>
    <height>360</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout_main">
   <property name="spacing">
    <number>4</number>
   </property>
   <item>
    <widget class="QTabWidget" name="tabWidget">
     <property name="currentIndex">
      <number>0</number>
     </property>

     <!-- ===================== TAB: Grids ===================== -->
     <widget class="QWidget" name="tab_grids">
      <attribute name="title">
       <string>Grids</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_grids">
       <property name="spacing">
        <number>4</number>
       </property>

       <item>
        <widget class="QRadioButton" name="rb_topMem">
         <property name="text">
          <string>Top surface: the grid loaded in this window</string>
         </property>
         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_top">
         <item>
          <widget class="QRadioButton" name="rb_topFile">
           <property name="text">
            <string>from file</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLineEdit" name="le_topFile">
           <property name="enabled">
            <bool>false</bool>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QToolButton" name="btn_topBrowse">
           <property name="enabled">
            <bool>false</bool>
           </property>
           <property name="text">
            <string>...</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>

       <item>
        <widget class="QCheckBox" name="chk_useBottom">
         <property name="text">
          <string>Bottom grid — compute the effect of the volume BETWEEN the two</string>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_bot">
         <item>
          <widget class="QLineEdit" name="le_botFile">
           <property name="enabled">
            <bool>false</bool>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QToolButton" name="btn_botBrowse">
           <property name="enabled">
            <bool>false</bool>
           </property>
           <property name="text">
            <string>...</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>

       <item>
        <layout class="QGridLayout" name="gridLayout_geom">
         <item row="0" column="0">
          <widget class="QLabel" name="lbl_thickness">
           <property name="text">
            <string>Layer thickness, m  (E)</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QLineEdit" name="le_thickness">
           <property name="toolTip">
            <string>Ignored in the two-grid mode [500 m]</string>
           </property>
          </widget>
         </item>
         <item row="0" column="2">
          <widget class="QLabel" name="lbl_zlevel">
           <property name="text">
            <string>Close body at  (Z)</string>
           </property>
          </widget>
         </item>
         <item row="0" column="3">
          <widget class="QComboBox" name="cb_zlevel">
           <property name="toolTip">
            <string>-Zb closes the body at its bottom (a dome), -Zt at its top (a spoon)</string>
           </property>
           <item>
            <property name="text">
             <string>(neither)</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>bottom</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>top</string>
            </property>
           </item>
          </widget>
         </item>
         <item row="1" column="0">
          <widget class="QLabel" name="lbl_pad">
           <property name="text">
            <string>Pad domain  (Q)</string>
           </property>
          </widget>
         </item>
         <item row="1" column="1" colspan="3">
          <widget class="QLineEdit" name="le_pad">
           <property name="toolTip">
            <string>n_pad (fake outer-rim width), a pad distance, or w/e/s/n — extends the computation domain beyond the output region</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>

       <item>
        <spacer name="verticalSpacer_grids">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>10</width>
           <height>4</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>

     <!-- ===================== TAB: Anomaly ===================== -->
     <widget class="QWidget" name="tab_anomaly">
      <attribute name="title">
