          <widget class="QLabel" name="lbl_threads">
           <property name="text">
            <string>Cores  (x)</string>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <widget class="QLineEdit" name="le_threads">
           <property name="toolTip">
            <string>Number of processors to use [all]</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>

       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_track">
         <item>
          <widget class="QLabel" name="lbl_track">
           <property name="text">
            <string>Track  (F)</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLineEdit" name="le_track">
           <property name="toolTip">
            <string>x,y file with the locations where the anomaly is computed. Mutually exclusive with a grid output — the result comes back as a table.</string>
