<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>InterpolationDialog</class>
 <widget class="QDialog" name="InterpolationDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>600</width>
    <height>470</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Interpolate</string>
  </property>
  <!--
    Layout is Mirone's "Surface" window (src_figs/griding_mir.m): Input Data File, the shared
    Griding Line Geometry block, "For Nearneighbor only" (search radius + units), the Griding
    Method combo with its per-method Options button, Verbose / Plot pts and Compute.

    The "Griding Line Geometry" group below is the verbatim copy of deps/ui/grid_line_geometry.ui
    (object names xMin/xMax/xInc/xN/yMin/yMax/yInc/yN/refEdit/refBtn/helpBtn kept EXACTLY). The C++
    side does NOT re-wire it: GeoGridGeometry::adopt(dlg) takes these very widgets over, so the
    dim-fun cross-recompute and the Ref-grid picker are the same implementation grdsample uses.

    The per-method Options window is NOT a .ui: its rows differ per gridding module (surface has 13,
    triangulate 1), so it is built from the option table in InterpolationDialog::optionSpec()
    (70_window.cpp) — one builder for every method, never a dialog per module.
  -->
  <layout class="QVBoxLayout" name="mainVerticalLayout">
   <property name="spacing"><number>8</number></property>
   <property name="margin" stdset="0"><number>8</number></property>
   <item>
    <widget class="QGroupBox" name="gb_input">
     <property name="title"><string>Input Data File</string></property>
     <layout class="QGridLayout" name="gridLayout_input">
      <property name="horizontalSpacing"><number>8</number></property>
      <property name="verticalSpacing"><number>4</number></property>
      <item row="0" column="0">
       <widget class="QCheckBox" name="chk_headers">
        <property name="toolTip"><string>The file starts with header lines to skip (-h)</string></property>
        <property name="text"><string>Headers?</string></property>
       </widget>
      </item>
      <item row="0" column="1"><widget class="QLabel" name="lb_nheaders"><property name="text"><string>N? of headers</string></property></widget></item>
      <item row="0" column="2">
       <widget class="QLineEdit" name="edit_nheaders">
        <property name="maximumWidth"><number>60</number></property>
        <property name="text"><string>0</string></property>
       </widget>
      </item>
      <item row="0" column="3">
       <spacer name="horizontalSpacer_hdr">
        <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
        <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
       </spacer>
      </item>
      <item row="1" column="0" colspan="4">
       <layout class="QHBoxLayout" name="horizontalLayout_infile">
        <item>
         <widget class="QLineEdit" name="edit_infile">
          <property name="toolTip"><string>x,y,z table to grid. Double-click to browse. Its own limits fill the geometry boxes below.</string></property>
         </widget>
        </item>
        <item><widget class="QToolButton" name="btn_infile"><property name="text"><string>...</string></property></widget></item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="geoGroup">
     <property name="title"><string>Griding Line Geometry</string></property>
     <layout class="QGridLayout" name="geoLayout">
      <property name="horizontalSpacing"><number>8</number></property>
      <property name="verticalSpacing"><number>4</number></property>
      <item row="0" column="1"><widget class="QLabel" name="minLab"><property name="alignment"><set>Qt::AlignHCenter</set></property><property name="text"><string>Min</string></property></widget></item>
      <item row="0" column="2"><widget class="QLabel" name="maxLab"><property name="alignment"><set>Qt::AlignHCenter</set></property><property name="text"><string>Max</string></property></widget></item>
      <item row="0" column="3"><widget class="QLabel" name="spacingLab"><property name="alignment"><set>Qt::AlignHCenter</set></property><property name="text"><string>Spacing</string></property></widget></item>
      <item row="0" column="4"><widget class="QLabel" name="nLinesLab"><property name="alignment"><set>Qt::AlignHCenter</set></property><property name="text"><string># of lines</string></property></widget></item>

      <item row="1" column="0"><widget class="QLabel" name="xDirLab"><property name="text"><string>X Direction</string></property></widget></item>
      <item row="1" column="1"><widget class="QLineEdit" name="xMin"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property></widget></item>
      <item row="1" column="2"><widget class="QLineEdit" name="xMax"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property></widget></item>
      <item row="1" column="3"><widget class="QLineEdit" name="xInc"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property></widget></item>
      <item row="1" column="4"><widget class="QLineEdit" name="xN"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property></widget></item>

      <item row="2" column="0"><widget class="QLabel" name="yDirLab"><property name="text"><string>Y Direction</string></property></widget></item>
      <item row="2" column="1"><widget class="QLineEdit" name="yMin"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property></widget></item>
      <item row="2" column="2"><widget class="QLineEdit" name="yMax"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property></widget></item>
      <item row="2" column="3"><widget class="QLineEdit" name="yInc"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property></widget></item>
      <item row="2" column="4"><widget class="QLineEdit" name="yN"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property></widget></item>

      <item row="1" column="5" rowspan="2">
       <widget class="QToolButton" name="helpBtn">
        <property name="text"><string>?</string></property>
        <property name="toolTip"><string>Edit any two of Min/Max/Spacing/# and the rest are derived.</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="refRow">
     <item><widget class="QLabel" name="refLab"><property name="text"><string>OR Ref grid</string></property></widget></item>
     <item>
      <widget class="QLineEdit" name="refEdit">
       <property name="toolTip"><string>Pick a grid/image; its region, spacing and size fill the boxes above.</string></property>
      </widget>
     </item>
     <item><widget class="QToolButton" name="refBtn"><property name="text"><string>...</string></property></widget></item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_flags">
     <item>
      <widget class="QCheckBox" name="chk_toggle">
       <property name="toolTip"><string>The file columns are y,x,z instead of x,y,z (-:)</string></property>
       <property name="text"><string>Toggle x,y</string></property>
      </widget>
     </item>
     <item>
      <widget class="QCheckBox" name="chk_pixel">
       <property name="toolTip"><string>Pixel registration for the output grid (-r)</string></property>
       <property name="text"><string>Pixel registration</string></property>
      </widget>
     </item>
     <item><widget class="QLabel" name="lb_coords"><property name="text"><string>Coordinates</string></property></widget></item>
     <item>
      <widget class="QComboBox" name="cb_coords">
       <property name="toolTip"><string>Whether x,y are longitude/latitude (-fg). "auto" asks GMT to guess from the data.</string></property>
      </widget>
     </item>
     <item>
      <spacer name="horizontalSpacer_flags">
       <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
      </spacer>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_nn">
     <property name="title"><string>For Near Neighbor only</string></property>
     <layout class="QHBoxLayout" name="horizontalLayout_nn">
      <item><widget class="QLabel" name="lb_radius"><property name="text"><string>Search Radius</string></property></widget></item>
      <item>
       <widget class="QLineEdit" name="edit_radius">
        <property name="maximumWidth"><number>90</number></property>
        <property name="toolTip"><string>Nodes with no data point closer than this stay empty (-S). Required by Near Neighbor.</string></property>
       </widget>
      </item>
      <item><widget class="QLabel" name="lb_units"><property name="text"><string>Unities</string></property></widget></item>
      <item>
       <widget class="QComboBox" name="cb_units">
        <property name="minimumWidth"><number>150</number></property>
        <property name="toolTip"><string>Unit the search radius is given in</string></property>
       </widget>
      </item>
      <item>
       <spacer name="horizontalSpacer_nn">
        <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
        <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
       </spacer>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_method">
     <property name="title"><string>Griding Method</string></property>
     <layout class="QHBoxLayout" name="horizontalLayout_method">
      <item>
       <widget class="QComboBox" name="cb_method">
        <property name="minimumWidth"><number>240</number></property>
        <property name="toolTip"><string>Which GMT module does the gridding</string></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="push_options">
        <property name="minimumSize"><size><width>90</width><height>24</height></size></property>
        <property name="toolTip"><string>The chosen method's own options</string></property>
        <property name="text"><string>Options</string></property>
       </widget>
      </item>
      <item>
       <spacer name="horizontalSpacer_method">
        <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
        <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
       </spacer>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_out">
     <item><widget class="QLabel" name="lb_out"><property name="text"><string>Save result to</string></property></widget></item>
     <item>
      <widget class="QLineEdit" name="edit_outfile">
       <property name="toolTip"><string>Optional output grid file. Leave empty to keep the result only in this window.</string></property>
      </widget>
     </item>
     <item><widget class="QToolButton" name="btn_outfile"><property name="text"><string>...</string></property></widget></item>
    </layout>
   </item>
   <item>
    <spacer name="verticalSpacer_bottom">
     <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
     <property name="sizeType"><enum>QSizePolicy::Policy::Fixed</enum></property>
     <property name="sizeHint" stdset="0"><size><width>20</width><height>6</height></size></property>
    </spacer>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_buttons">
     <item>
      <widget class="QCheckBox" name="chk_verbose">
       <property name="toolTip"><string>Let the module report its progress in the Julia console (-V)</string></property>
       <property name="text"><string>Verbose</string></property>
      </widget>
     </item>
     <item>
      <widget class="QCheckBox" name="chk_plotpts">
       <property name="toolTip"><string>Also draw the input data points over the new grid</string></property>
       <property name="text"><string>Plot pts</string></property>
      </widget>
     </item>
     <item>
      <spacer name="buttonsSpacer">
       <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="push_compute">
       <property name="minimumSize"><size><width>90</width><height>24</height></size></property>
       <property name="text"><string>Compute</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="push_close">
       <property name="minimumSize"><size><width>70</width><height>24</height></size></property>
       <property name="text"><string>Close</string></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
