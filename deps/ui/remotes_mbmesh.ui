    <property name="toolTip">
     <string>Store the vertices relative to a GeoOrigin at the centre of the data (mbmesh --geoorigin). Without it the GLB vertices are absolute Earth-centred coordinates in 32-bit floats, which resolve only about half a meter.</string>
    </property>
    <property name="text">
     <string>GeoOrigin (keeps sub-meter detail)</string>
    </property>
    <property name="checked">
     <bool>true</bool>
    </property>
