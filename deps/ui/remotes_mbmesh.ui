      <height>26</height>
     </rect>
    </property>
    <property name="toolTip">
     <string>Choose the point data to mesh</string>
    </property>
    <property name="text">
     <string>...</string>
    </property>
    <property name="filter" stdset="0">
     <string>Point data (*.mb* *.las *.laz *.xyz *.xyt *.txt *.dat *.csv);;All files (*)</string>
    </property>
   </widget>
