    <property name="geometry">
     <rect>
      <x>71</x>
      <y>27</y>
      <width>416</width>
      <height>26</height>
     </rect>
    </property>
    <property name="toolTip">
     <string>Fast: the soundings themselves are the vertices, joined by a Delaunay triangulation (under a second; level of detail and decimate do not apply). mbmesh: MB-System's screened Poisson surface, a smooth watertight mesh, far slower.</string>
    </property>
    <item>
     <property name="text">
      <string>Fast: triangulate the soundings</string>
     </property>
    </item>
    <item>
     <property name="text">
      <string>mbmesh: Poisson surface (slow)</string>
     </property>
    </item>
   </widget>
