      <height>26</height>
     </rect>
    </property>
    <property name="toolTip">
     <string>The point data to mesh: an MB-System swath file (.mbXX, XX its MBIO format) or datalist (.mb-1), a LAS/LAZ file, or an x,y,z table. A table's z is a height, positive up. Data in another coordinate system is taken to longitude and latitude with the system its file declares. Filled in with the point file this window shows, if it shows one.</string>
    </property>
    <property name="refresh" stdset="0">
     <bool>true</bool>
    </property>
   </widget>
