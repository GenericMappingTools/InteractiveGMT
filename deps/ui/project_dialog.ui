   <property name="text"><string>Projections</string></property>
  </widget>
  <widget class="QComboBox" name="combo_proj">
   <property name="geometry"><rect><x>380</x><y>5</y><width>151</width><height>22</height></rect></property>
   <property name="toolTip"><string>Pick a projection to fill the Destination box with its PROJ4 string. Edit it freely afterwards.</string></property>
  </widget>

  <widget class="QLabel" name="lb_source">
   <property name="geometry"><rect><x>15</x><y>15</y><width>170</width><height>16</height></rect></property>
   <property name="text"><string>Source Referencing System</string></property>
  </widget>
  <widget class="QPlainTextEdit" name="edit_source">
   <property name="geometry"><rect><x>10</x><y>32</y><width>521</width><height>41</height></rect></property>
   <property name="toolTip"><string>PROJ4 (or WKT / EPSG:nnnn) describing the source coordinate system. Blank defaults to geogs.</string></property>
  </widget>

  <widget class="QLabel" name="lb_target">
   <property name="geometry"><rect><x>10</x><y>85</y><width>200</width><height>18</height></rect></property>
   <property name="text"><string>Destination Referencing System</string></property>
  </widget>
  <widget class="QPlainTextEdit" name="edit_target">
   <property name="geometry"><rect><x>10</x><y>101</y><width>521</width><height>41</height></rect></property>
   <property name="toolTip"><string>PROJ4 (or WKT / EPSG:nnnn) with the target coordinate system. Blank defaults to geogs.</string></property>
  </widget>

  <widget class="QGroupBox" name="gb_interp">
   <property name="geometry"><rect><x>10</x><y>144</y><width>345</width><height>44</height></rect></property>
   <property name="title"><string>Interpolation method</string></property>
   <widget class="QRadioButton" name="rb_near">
    <property name="geometry"><rect><x>8</x><y>17</y><width>125</width><height>18</height></rect></property>
    <property name="toolTip"><string>nearest neighbour resampling (fastest algorithm, worst interpolation quality)</string></property>
    <property name="text"><string>nearest neighbour</string></property>
    <attribute name="buttonGroup"><string>bg_interp</string></attribute>
   </widget>
   <widget class="QRadioButton" name="rb_bilinear">
