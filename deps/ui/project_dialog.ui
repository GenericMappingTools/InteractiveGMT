<?xml version="1.0" encoding="UTF-8"?>
<!-- Project (Mirone's "Projections > GDAL project", the GDAL dropped from the name). Geometry is
     Mirone's own, converted from src_figs/gdal_project.m's gdal_project_LayoutFcn (figure 540x241,
     MATLAB bottom-left origin -> Qt top-left: y_qt = 241 - y_m - h). Absolute positions on purpose:
     the window is fixed-size exactly as Mirone's ('Resize','off'), so every control keeps the size
     it has there: the Rows/Columns boxes are 49x21 and the inc boxes 71x21, not stretched.
     Widened only where the real Qt font clips: the two SRS labels and the interpolation group box
     (a MATLAB 'frame' + floating text, here the group box's own title). -->
<ui version="4.0">
 <class>ProjectDialog</class>
 <widget class="QDialog" name="ProjectDialog">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>540</width><height>241</height></rect>
  </property>
  <property name="minimumSize"><size><width>540</width><height>241</height></size></property>
  <property name="maximumSize"><size><width>540</width><height>241</height></size></property>
  <property name="windowTitle"><string>Project</string></property>

  <widget class="QLabel" name="lb_proj">
   <property name="geometry"><rect><x>300</x><y>8</y><width>76</width><height>15</height></rect></property>
