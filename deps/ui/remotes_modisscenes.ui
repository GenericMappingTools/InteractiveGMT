        <height>26</height>
       </rect>
      </property>
      <property name="toolTip">
       <string>Where the orbit comes from. Celestrak: downloaded automatically, no file needed, but only the CURRENT elements, which are good for a few weeks around today. Space-Track history: for any past date, the satellite's element sets of that month, downloaded once with your Space-Track login (Accounts tab) and kept on disk, so a month is never asked for twice. TLE file: a file of element sets of your own. For both, the set whose epoch is nearest the date is used.</string>
      </property>
      <property name="refresh" stdset="0">
       <bool>true</bool>
      </property>
      <item>
       <property name="text">
