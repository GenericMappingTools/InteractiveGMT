<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>GravFFTDialog</class>
 <widget class="QDialog" name="GravFFTDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>470</width>
    <height>580</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>gravfft</string>
  </property>
  <layout class="QVBoxLayout" name="mainVerticalLayout">
   <property name="spacing">
    <number>8</number>
   </property>
   <property name="margin" stdset="0">
    <number>8</number>
   </property>
   <item>
    <widget class="QGroupBox" name="gb_common">
     <property name="title">
      <string>Geopotential field and expansion</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_common">
      <item row="0" column="0">
       <widget class="QLabel" name="lb_field"><property name="text"><string>Field (F)</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="cb_field">
        <property name="toolTip"><string>What to compute: free-air anomaly (with or without the slab / zero far-field correction), Bouguer, geoid, vertical gravity gradient or a deflection of the vertical</string></property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QLabel" name="lb_terms"><property name="text"><string>Parker terms (E)</string></property></widget>
      </item>
      <item row="0" column="3">
       <widget class="QComboBox" name="cb_terms">
        <property name="minimumSize"><size><width>60</width><height>0</height></size></property>
        <property name="toolTip"><string>Number of terms of the Parker expansion [3]. Limited to 10.</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lb_level"><property name="text"><string>Water depth (W)</string></property></widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="edit_level">
        <property name="toolTip"><string>Water depth, or observation level, relative to the topography [0]. Positive.</string></property>
       </widget>
      </item>
      <item row="1" column="2">
       <widget class="QCheckBox" name="chk_levelkm">
        <property name="toolTip"><string>The depth above is in km instead of m</string></property>
        <property name="text"><string>in km</string></property>
       </widget>
      </item>
      <item row="1" column="3">
       <widget class="QCheckBox" name="chk_geog">
        <property name="toolTip"><string>Grid is in degrees: convert to meters with a "Flat Earth" approximation (-fg)</string></property>
        <property name="text"><string>Geographic</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QTabWidget" name="tabs_mode">
     <property name="currentIndex">
      <number>0</number>
     </property>
     <widget class="QWidget" name="tab_surface">
      <attribute name="title"><string>Surface (D)</string></attribute>
      <layout class="QVBoxLayout" name="verticalLayout_surface">
       <item>
        <widget class="QLabel" name="lb_surface_help">
         <property name="text"><string>Geopotential of the window's surface, given the density contrast across it.</string></property>
         <property name="wordWrap"><bool>true</bool></property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_density">
         <item>
          <widget class="QLabel" name="lb_density"><property name="text"><string>Density contrast (SI)</string></property></widget>
         </item>
         <item>
          <widget class="QLineEdit" name="edit_density">
           <property name="toolTip"><string>A constant density contrast in kg/m^3, or a co-registered grid holding a variable one. Double-click to browse for a grid.</string></property>
          </widget>
         </item>
         <item>
          <widget class="QToolButton" name="btn_density">
           <property name="text"><string>...</string></property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <spacer name="verticalSpacer_surface">
         <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
         <property name="sizeHint" stdset="0"><size><width>20</width><height>10</height></size></property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tab_flexure">
      <attribute name="title"><string>Flexure (T)</string></attribute>
      <layout class="QVBoxLayout" name="verticalLayout_flexure">
       <item>
        <widget class="QLabel" name="lb_flexure_help">
         <property name="text"><string>Isostatic compensation of the window's topography on the elastic plate set below.</string></property>
         <property name="wordWrap"><bool>true</bool></property>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="chk_moho">
         <property name="toolTip"><string>Write the Moho's own geopotential effect (T ... +m). Needs the Moho depth.</string></property>
         <property name="text"><string>Moho's geopotential effect (+m)</string></property>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="chk_flextopo">
         <property name="toolTip"><string>Write the flexural topography (the "gravimetric Moho", z positive up) instead of a field (Q)</string></property>
         <property name="text"><string>Flexural topography (Q)</string></property>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="chk_subplate">
         <property name="toolTip"><string>Field due to a subplate load under the current bathymetry (S). Needs both compensation depths; the Parker expansion is restricted to one term.</string></property>
         <property name="text"><string>Subplate load response (S)</string></property>
        </widget>
       </item>
       <item>
        <spacer name="verticalSpacer_flexure">
         <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
         <property name="sizeHint" stdset="0"><size><width>20</width><height>10</height></size></property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tab_admitt">
      <attribute name="title"><string>Admittance (I)</string></attribute>
      <layout class="QVBoxLayout" name="verticalLayout_admitt">
       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_grid2">
         <item>
          <widget class="QLabel" name="lb_grid2"><property name="text"><string>Gravity/geoid grid</string></property></widget>
         </item>
         <item>
          <widget class="QLineEdit" name="edit_grid2">
           <property name="toolTip"><string>The second grid: gravity or geoid over the SAME region and geometry as this window's grid. Double-click to browse.</string></property>
          </widget>
         </item>
         <item>
          <widget class="QToolButton" name="btn_grid2">
           <property name="text"><string>...</string></property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_iflags">
         <item>
          <widget class="QCheckBox" name="chk_coherence">
           <property name="toolTip"><string>Compute the coherence instead of the admittance (c)</string></property>
           <property name="text"><string>Coherence</string></property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="chk_wavelength">
           <property name="toolTip"><string>Write wavelength instead of wavenumber (w)</string></property>
           <property name="text"><string>Wavelength</string></property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="chk_km">
           <property name="toolTip"><string>Wavelength in km instead of m (k)</string></property>
           <property name="text"><string>in km</string></property>
          </widget>
         </item>
         <item>
          <spacer name="horizontalSpacer_iflags">
           <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
           <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
          </spacer>
         </item>
        </layout>
       </item>
       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_theomodel">
         <item>
          <widget class="QLabel" name="lb_theomodel"><property name="text"><string>Theoretical curve</string></property></widget>
         </item>
         <item>
          <widget class="QComboBox" name="cb_theomodel">
           <property name="toolTip"><string>Add a fourth column with the theoretical admittance of the elastic plate model set below (t = loading from top, b = loading from below). Only for the free-air anomaly or the geoid.</string></property>
          </widget>
         </item>
         <item>
          <spacer name="horizontalSpacer_theomodel">
           <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
           <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
          </spacer>
         </item>
        </layout>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tab_theo">
      <attribute name="title"><string>Theoretical (C)</string></attribute>
      <layout class="QVBoxLayout" name="verticalLayout_theo">
       <item>
        <widget class="QLabel" name="lb_theo_help">
         <property name="text"><string>Only the theoretical admittance curve of the model below — no grid is read.</string></property>
         <property name="wordWrap"><bool>true</bool></property>
        </widget>
       </item>
       <item>
        <layout class="QGridLayout" name="gridLayout_theo">
         <item row="0" column="0">
          <widget class="QLabel" name="lb_cn"><property name="text"><string>Points</string></property></widget>
         </item>
         <item row="0" column="1">
          <widget class="QLineEdit" name="edit_cn">
           <property name="toolTip"><string>Number of points of the curve. Points x wavelength is the profile length in meters.</string></property>
          </widget>
         </item>
         <item row="0" column="2">
          <widget class="QLabel" name="lb_clambda"><property name="text"><string>Wavelength (m)</string></property></widget>
         </item>
         <item row="0" column="3">
          <widget class="QLineEdit" name="edit_clambda">
           <property name="toolTip"><string>Wavelength increment in meters</string></property>
          </widget>
         </item>
         <item row="1" column="0">
          <widget class="QLabel" name="lb_cdepth"><property name="text"><string>Mean depth (m)</string></property></widget>
         </item>
         <item row="1" column="1">
          <widget class="QLineEdit" name="edit_cdepth">
           <property name="toolTip"><string>Mean water depth in meters</string></property>
          </widget>
         </item>
         <item row="1" column="2">
          <widget class="QLabel" name="lb_cmodel"><property name="text"><string>Model</string></property></widget>
         </item>
         <item row="1" column="3">
          <widget class="QComboBox" name="cb_cmodel">
           <property name="toolTip"><string>Loading from top (elastic plate) or loading from below (sub-surface load)</string></property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QCheckBox" name="chk_cwave">
         <property name="toolTip"><string>Write wavelength instead of frequency (w)</string></property>
         <property name="text"><string>Wavelength instead of frequency</string></property>
        </widget>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_plate">
     <property name="title">
      <string>Elastic plate model (T, Z)</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_plate">
      <item row="0" column="0">
       <widget class="QLabel" name="lb_te"><property name="text"><string>Te (m)</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="edit_te">
        <property name="toolTip"><string>Elastic thickness in meters. Zero gives the Airy response; a value &gt; 1e10 is taken as the flexural rigidity.</string></property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QLabel" name="lb_rhol"><property name="text"><string>Load density</string></property></widget>
      </item>
      <item row="0" column="3">
       <widget class="QLineEdit" name="edit_rhol">
        <property name="toolTip"><string>Density of the load, SI (e.g. 2700)</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lb_rhom"><property name="text"><string>Mantle density</string></property></widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="edit_rhom">
        <property name="toolTip"><string>Density of the mantle, SI (e.g. 3300)</string></property>
       </widget>
      </item>
      <item row="1" column="2">
       <widget class="QLabel" name="lb_rhow"><property name="text"><string>Water density</string></property></widget>
      </item>
      <item row="1" column="3">
       <widget class="QLineEdit" name="edit_rhow">
        <property name="toolTip"><string>Density of the water layer, SI (e.g. 1035)</string></property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="lb_rhoi"><property name="text"><string>Infill density</string></property></widget>
      </item>
      <item row="2" column="1">
       <widget class="QLineEdit" name="edit_rhoi">
        <property name="toolTip"><string>Optional density of the material filling the flexural depression [same as the load]</string></property>
       </widget>
      </item>
      <item row="2" column="2">
       <widget class="QLabel" name="lb_zm"><property name="text"><string>Moho depth (m)</string></property></widget>
      </item>
      <item row="2" column="3">
       <widget class="QLineEdit" name="edit_zm">
        <property name="toolTip"><string>Average Moho compensation depth, positive down (Z)</string></property>
       </widget>
      </item>
      <item row="3" column="2">
       <widget class="QLabel" name="lb_zl"><property name="text"><string>Load depth (m)</string></property></widget>
      </item>
      <item row="3" column="3">
       <widget class="QLineEdit" name="edit_zl">
        <property name="toolTip"><string>Average depth of the sub-surface load, only for the "loading from below" model (Z zm/zl)</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_fft">
     <property name="title">
      <string>FFT (N)</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_fft">
      <item row="0" column="0">
       <widget class="QLabel" name="lb_fftdim"><property name="text"><string>Dimensions</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="cb_fftdim">
        <property name="toolTip"><string>How the FFT grid size is chosen. The default balances speed and accuracy.</string></property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QLineEdit" name="edit_fftdims">
        <property name="toolTip"><string>nx/ny of the FFT array, only for "given below". Must be &gt;= the grid size.</string></property>
       </widget>
      </item>
      <item row="0" column="3">
       <widget class="QCheckBox" name="chk_fftverbose">
        <property name="toolTip"><string>Report the dimensions actually used (+v)</string></property>
        <property name="text"><string>Report</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lb_detrend"><property name="text"><string>Detrend</string></property></widget>
      </item>
      <item row="1" column="1">
       <widget class="QComboBox" name="cb_detrend">
        <property name="toolTip"><string>What is removed before the FFT. gravfft's own default is the mid value (Parker).</string></property>
       </widget>
      </item>
      <item row="1" column="2">
       <widget class="QComboBox" name="cb_extend">
        <property name="toolTip"><string>How the grid is extended to the FFT size before tapering</string></property>
       </widget>
      </item>
      <item row="1" column="3">
       <widget class="QLineEdit" name="edit_taper">
        <property name="toolTip"><string>Taper width in percent of the margin [100]</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_out">
     <item>
      <widget class="QLabel" name="lb_out"><property name="text"><string>Save result to</string></property></widget>
     </item>
     <item>
      <widget class="QLineEdit" name="edit_outfile">
       <property name="toolTip"><string>Optional output file (a grid, or a table for the admittance/coherence). Leave empty to keep the result only in this session.</string></property>
      </widget>
     </item>
     <item>
      <widget class="QToolButton" name="btn_outfile">
       <property name="text"><string>...</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <spacer name="verticalSpacer_bottom">
     <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
     <property name="sizeType"><enum>QSizePolicy::Policy::Fixed</enum></property>
     <property name="sizeHint" stdset="0"><size><width>20</width><height>6</height></size></property>
    </spacer>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_buttons">
     <item>
      <spacer name="buttonsSpacer">
       <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="push_compute">
       <property name="minimumSize"><size><width>90</width><height>24</height></size></property>
       <property name="text"><string>Compute</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="push_close">
       <property name="minimumSize"><size><width>70</width><height>24</height></size></property>
       <property name="text"><string>Close</string></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
