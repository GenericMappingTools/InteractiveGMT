<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>GrdFilterDialog</class>
 <widget class="QDialog" name="GrdFilterDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>580</width>
    <height>440</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>grdfilter</string>
  </property>
  <!--
    The "Griding Line Geometry" group below is the verbatim copy of deps/ui/grid_line_geometry.ui
    (object names xMin/xMax/xInc/xN/yMin/yMax/yInc/yN/refEdit/refBtn/helpBtn kept EXACTLY). The C++
    side does NOT re-wire it: GeoGridGeometry::adopt(dlg) takes these very widgets over, so the
    dim-fun cross-recompute and the Ref-grid picker are the same implementation grdsample uses.
  -->
  <layout class="QVBoxLayout" name="mainVerticalLayout">
   <property name="spacing"><number>8</number></property>
   <property name="margin" stdset="0"><number>8</number></property>
   <item>
    <widget class="QGroupBox" name="geoGroup">
     <property name="title"><string>Griding Line Geometry</string></property>
     <layout class="QGridLayout" name="geoLayout">
      <property name="horizontalSpacing"><number>8</number></property>
      <property name="verticalSpacing"><number>4</number></property>
      <item row="0" column="1"><widget class="QLabel" name="minLab"><property name="alignment"><set>Qt::AlignHCenter</set></property><property name="text"><string>Min</string></property></widget></item>
      <item row="0" column="2"><widget class="QLabel" name="maxLab"><property name="alignment"><set>Qt::AlignHCenter</set></property><property name="text"><string>Max</string></property></widget></item>
      <item row="0" column="3"><widget class="QLabel" name="spacingLab"><property name="alignment"><set>Qt::AlignHCenter</set></property><property name="text"><string>Spacing</string></property></widget></item>
      <item row="0" column="4"><widget class="QLabel" name="nLinesLab"><property name="alignment"><set>Qt::AlignHCenter</set></property><property name="text"><string># of lines</string></property></widget></item>

      <item row="1" column="0"><widget class="QLabel" name="xDirLab"><property name="text"><string>X Direction</string></property></widget></item>
      <item row="1" column="1"><widget class="QLineEdit" name="xMin"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property><property name="text"><string>-180</string></property></widget></item>
      <item row="1" column="2"><widget class="QLineEdit" name="xMax"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property><property name="text"><string>180</string></property></widget></item>
      <item row="1" column="3"><widget class="QLineEdit" name="xInc"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property><property name="text"><string>1</string></property></widget></item>
      <item row="1" column="4"><widget class="QLineEdit" name="xN"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property><property name="text"><string>361</string></property></widget></item>

      <item row="2" column="0"><widget class="QLabel" name="yDirLab"><property name="text"><string>Y Direction</string></property></widget></item>
      <item row="2" column="1"><widget class="QLineEdit" name="yMin"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property><property name="text"><string>-89</string></property></widget></item>
      <item row="2" column="2"><widget class="QLineEdit" name="yMax"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property><property name="text"><string>89</string></property></widget></item>
      <item row="2" column="3"><widget class="QLineEdit" name="yInc"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property><property name="text"><string>1</string></property></widget></item>
      <item row="2" column="4"><widget class="QLineEdit" name="yN"><property name="minimumWidth"><number>80</number></property><property name="maximumWidth"><number>110</number></property><property name="text"><string>179</string></property></widget></item>

      <item row="1" column="5" rowspan="2">
       <widget class="QToolButton" name="helpBtn">
        <property name="text"><string>?</string></property>
        <property name="toolTip"><string>Edit any two of Min/Max/Spacing/# and the rest are derived.</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="refRow">
     <item><widget class="QLabel" name="refLab"><property name="text"><string>OR Ref grid</string></property></widget></item>
     <item>
      <widget class="QLineEdit" name="refEdit">
       <property name="toolTip"><string>Pick a grid/image; its region, spacing and size fill the boxes above.</string></property>
      </widget>
     </item>
     <item><widget class="QToolButton" name="refBtn"><property name="text"><string>...</string></property></widget></item>
    </layout>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_filter">
     <property name="title"><string>Filter</string></property>
     <layout class="QGridLayout" name="gridLayout_filter">
      <property name="horizontalSpacing"><number>8</number></property>
      <property name="verticalSpacing"><number>4</number></property>
      <item row="0" column="0"><widget class="QLabel" name="lb_type"><property name="text"><string>Filter type</string></property></widget></item>
      <item row="0" column="1"><widget class="QLabel" name="lb_width"><property name="text"><string>Filter width</string></property></widget></item>
      <item row="0" column="2"><widget class="QLabel" name="lb_width2"><property name="text"><string>Width 2 (rect)</string></property></widget></item>
      <item row="1" column="0">
       <widget class="QComboBox" name="cb_type">
        <property name="minimumWidth"><number>160</number></property>
        <property name="toolTip"><string>Convolution (boxcar / cosine arch / gaussian / custom / operator) or non-convolution (median, modes, extremes) filter</string></property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="edit_width">
        <property name="maximumWidth"><number>90</number></property>
        <property name="toolTip"><string>Full filter DIAMETER, in the units the distance flag implies. Required.</string></property>
       </widget>
      </item>
      <item row="1" column="2">
       <widget class="QLineEdit" name="edit_width2">
        <property name="maximumWidth"><number>90</number></property>
        <property name="toolTip"><string>Second width makes the filter RECTANGULAR. Only with distance flag p or 0.</string></property>
       </widget>
      </item>
      <item row="1" column="3">
       <widget class="QCheckBox" name="chk_highpass">
        <property name="toolTip"><string>Return data minus the filtered result (+h) instead of the filtered result</string></property>
        <property name="text"><string>High-pass</string></property>
       </widget>
      </item>
      <item row="2" column="0" colspan="4">
       <layout class="QHBoxLayout" name="horizontalLayout_extra">
        <item>
         <widget class="QLabel" name="lb_quantile"><property name="text"><string>Quantile</string></property></widget>
        </item>
        <item>
         <widget class="QLineEdit" name="edit_quantile">
          <property name="maximumWidth"><number>70</number></property>
          <property name="toolTip"><string>Median filter: use this quantile (0-1) instead of 0.5 (+q)</string></property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="lb_binwidth"><property name="text"><string>Bin width</string></property></widget>
        </item>
        <item>
         <widget class="QLineEdit" name="edit_binwidth">
          <property name="maximumWidth"><number>70</number></property>
          <property name="toolTip"><string>Histogram mode: binning interval</string></property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="chk_centerbins">
          <property name="toolTip"><string>Center the bins on multiples of the bin width (+c)</string></property>
          <property name="text"><string>Center bins</string></property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="lb_mode"><property name="text"><string>Multiple modes</string></property></widget>
        </item>
        <item>
         <widget class="QComboBox" name="cb_mode">
          <property name="toolTip"><string>Which mode to return when several are found (+l / +u)</string></property>
         </widget>
        </item>
        <item>
         <spacer name="horizontalSpacer_extra">
          <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
          <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
         </spacer>
        </item>
       </layout>
      </item>
      <item row="3" column="0" colspan="4">
       <layout class="QHBoxLayout" name="horizontalLayout_wgrid">
        <item><widget class="QLabel" name="lb_wgrid"><property name="text"><string>Weight grid</string></property></widget></item>
        <item>
         <widget class="QLineEdit" name="edit_wgrid">
          <property name="toolTip"><string>Custom / Operator filter: the grid holding the filter weights. Double-click to browse.</string></property>
         </widget>
        </item>
        <item><widget class="QToolButton" name="btn_wgrid"><property name="text"><string>...</string></property></widget></item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_dist">
     <item><widget class="QLabel" name="lb_dist"><property name="text"><string>Distance flag</string></property></widget></item>
     <item>
      <widget class="QComboBox" name="cb_dist">
       <property name="minimumWidth"><number>230</number></property>
       <property name="toolTip"><string>How the grid (x,y) relate to the filter width (-D). Flags 3-5 recompute the weights per latitude and are slower.</string></property>
      </widget>
     </item>
     <item><widget class="QLabel" name="lb_nans"><property name="text"><string>NaNs</string></property></widget></item>
     <item>
      <widget class="QComboBox" name="cb_nans">
       <property name="toolTip"><string>How NaNs in the input affect the output (-N)</string></property>
      </widget>
     </item>
     <item>
      <widget class="QCheckBox" name="chk_toggle">
       <property name="toolTip"><string>Flip the output registration, gridline &lt;-&gt; pixel (-T)</string></property>
       <property name="text"><string>Toggle registration</string></property>
      </widget>
     </item>
     <item>
      <spacer name="horizontalSpacer_dist">
       <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
      </spacer>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_out">
     <item><widget class="QLabel" name="lb_out"><property name="text"><string>Save result to</string></property></widget></item>
     <item>
      <widget class="QLineEdit" name="edit_outfile">
       <property name="toolTip"><string>Optional output grid file. Leave empty to keep the result only in this window.</string></property>
      </widget>
     </item>
     <item><widget class="QToolButton" name="btn_outfile"><property name="text"><string>...</string></property></widget></item>
    </layout>
   </item>
   <item>
    <spacer name="verticalSpacer_bottom">
     <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
     <property name="sizeType"><enum>QSizePolicy::Policy::Fixed</enum></property>
     <property name="sizeHint" stdset="0"><size><width>20</width><height>6</height></size></property>
    </spacer>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_buttons">
     <item>
      <spacer name="buttonsSpacer">
       <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="push_compute">
       <property name="minimumSize"><size><width>90</width><height>24</height></size></property>
       <property name="text"><string>Compute</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="push_close">
       <property name="minimumSize"><size><width>70</width><height>24</height></size></property>
       <property name="text"><string>Close</string></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
