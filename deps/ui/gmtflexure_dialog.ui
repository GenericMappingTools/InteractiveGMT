<?xml version="1.0" encoding="UTF-8"?>
<!--
  gmtflexure_dialog.ui — GMT menu > "gmtflexure": the flexure of a 2-D (profile) plate under a load,
  by finite differences. Loaded at RUNTIME by GmtFlexureDialog (deps/src/70_window.cpp) via QUiLoader.
  Option letters are in the labels: Q load, E plate, D densities, A boundaries, C constants, F force,
  L variable restoring force, M units, S curvature, T pre-existing deformation, W water, Z level.
-->
<ui version="4.0">
 <class>GmtFlexureDialog</class>
 <widget class="QDialog" name="GmtFlexureDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>500</width>
    <height>660</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>gmtflexure</string>
  </property>
  <layout class="QVBoxLayout" name="mainVerticalLayout">
   <property name="spacing"><number>6</number></property>
   <property name="margin" stdset="0"><number>8</number></property>
   <item>
    <widget class="QLabel" name="lb_hint">
     <property name="text"><string>Flexure of a 2-D plate along a profile: the moat under a load and the bulge beside it, solved by finite differences.</string></property>
     <property name="wordWrap"><bool>true</bool></property>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_load">
     <property name="title"><string>The load (Q)</string></property>
     <layout class="QGridLayout" name="gridLayout_load">
      <item row="0" column="0" colspan="2">
       <widget class="QRadioButton" name="rb_qt">
        <property name="toolTip"><string>A file of x and topography (Qt) — heights, positive up</string></property>
        <property name="text"><string>Topography</string></property>
        <property name="checked"><bool>true</bool></property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QRadioButton" name="rb_qq">
        <property name="toolTip"><string>A file of x and load in Pa (Qq)</string></property>
        <property name="text"><string>Loads in Pa</string></property>
       </widget>
      </item>
      <item row="0" column="3">
       <widget class="QRadioButton" name="rb_qn">
        <property name="toolTip"><string>No load at all (Qn): the deformation comes from the boundary conditions alone</string></property>
        <property name="text"><string>No load</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lb_loadfile"><property name="text"><string>File</string></property></widget>
      </item>
      <item row="1" column="1" colspan="2">
       <widget class="QLineEdit" name="edit_loadfile">
        <property name="toolTip"><string>The load or topography profile, one x per record. Double-click to browse.</string></property>
       </widget>
      </item>
      <item row="1" column="3">
       <widget class="QToolButton" name="btn_loadfile"><property name="text"><string>...</string></property></widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="lb_qmin"><property name="text"><string>From x</string></property></widget>
      </item>
      <item row="2" column="1">
       <widget class="QLineEdit" name="edit_qmin">
        <property name="toolTip"><string>With no load, the profile to compute on: first x</string></property>
       </widget>
      </item>
      <item row="2" column="2">
       <widget class="QLabel" name="lb_qmax"><property name="text"><string>to</string></property></widget>
      </item>
      <item row="2" column="3">
       <widget class="QLineEdit" name="edit_qmax"/>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="lb_qinc"><property name="text"><string>Step</string></property></widget>
      </item>
      <item row="3" column="1">
       <widget class="QLineEdit" name="edit_qinc">
        <property name="toolTip"><string>Not needed when the plate thickness comes from a file — that file already says where the nodes are.</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_plate">
     <property name="title"><string>Plate and densities (E, D)</string></property>
     <layout class="QGridLayout" name="gridLayout_plate">
      <item row="0" column="0">
       <widget class="QLabel" name="lb_te"><property name="text"><string>Thickness</string></property></widget>
      </item>
      <item row="0" column="1" colspan="2">
       <widget class="QLineEdit" name="edit_te">
        <property name="toolTip"><string>Elastic thickness in metres, or with k for km (e.g. 10k). Above 1e10 it is read as a flexural rigidity instead. Or the name of a file of variable thickness — double-click to browse.</string></property>
       </widget>
      </item>
      <item row="0" column="3">
       <widget class="QToolButton" name="btn_te"><property name="text"><string>...</string></property></widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lb_rhom"><property name="text"><string>Mantle</string></property></widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="edit_rhom"/>
      </item>
      <item row="1" column="2">
       <widget class="QLabel" name="lb_rhol"><property name="text"><string>Load</string></property></widget>
      </item>
      <item row="1" column="3">
       <widget class="QLineEdit" name="edit_rhol"/>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="lb_rhoi"><property name="text"><string>Infill</string></property></widget>
      </item>
      <item row="2" column="1">
       <widget class="QLineEdit" name="edit_rhoi">
        <property name="toolTip"><string>Empty = the same as the load density</string></property>
       </widget>
      </item>
      <item row="2" column="2">
       <widget class="QLabel" name="lb_rhow"><property name="text"><string>Water</string></property></widget>
      </item>
      <item row="2" column="3">
       <widget class="QLineEdit" name="edit_rhow"/>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_bc">
     <property name="title"><string>Boundary conditions (A)</string></property>
     <layout class="QGridLayout" name="gridLayout_bc">
      <item row="0" column="0">
       <widget class="QLabel" name="lb_lbc"><property name="text"><string>Left</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="cb_lbc">
        <property name="toolTip"><string>Condition at the left end of the profile</string></property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QLineEdit" name="edit_largs">
        <property name="toolTip"><string>Clamped: the deflection. Free: moment/force. The other two take nothing.</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lb_rbc"><property name="text"><string>Right</string></property></widget>
      </item>
      <item row="1" column="1">
       <widget class="QComboBox" name="cb_rbc">
        <property name="toolTip"><string>Condition at the right end of the profile</string></property>
       </widget>
      </item>
      <item row="1" column="2">
       <widget class="QLineEdit" name="edit_rargs">
        <property name="toolTip"><string>Clamped: the deflection. Free: moment/force. The other two take nothing.</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_extra">
     <property name="title"><string>Model</string></property>
     <layout class="QGridLayout" name="gridLayout_extra">
      <item row="0" column="0">
       <widget class="QLabel" name="lb_force"><property name="text"><string>In-plane force (F)</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="edit_force">
        <property name="toolTip"><string>Constant horizontal in-plane force in Pa m [0]</string></property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QLabel" name="lb_water"><property name="text"><string>Water depth (W)</string></property></widget>
      </item>
      <item row="0" column="3">
       <widget class="QLineEdit" name="edit_water">
        <property name="toolTip"><string>In metres, or with k for km. Topography above it is rescaled for the air contrast.</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lb_zobs"><property name="text"><string>Level offset (Z)</string></property></widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="edit_zobs">
        <property name="toolTip"><string>Distance from the observation level down to the undeformed surface, in metres or with k for km. Subtracted before output.</string></property>
       </widget>
      </item>
      <item row="1" column="2">
       <widget class="QLabel" name="lb_wfile"><property name="text"><string>Pre-deformed (T)</string></property></widget>
      </item>
      <item row="1" column="3">
       <widget class="QLineEdit" name="edit_wfile">
        <property name="toolTip"><string>A file of pre-existing deformation. Double-click to browse.</string></property>
       </widget>
      </item>
      <item row="1" column="4">
       <widget class="QToolButton" name="btn_wfile"><property name="text"><string>...</string></property></widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="lb_poisson"><property name="text"><string>Poisson (Cp)</string></property></widget>
      </item>
      <item row="2" column="1">
       <widget class="QLineEdit" name="edit_poisson">
        <property name="toolTip"><string>Poisson's ratio [0.25]</string></property>
       </widget>
      </item>
      <item row="2" column="2">
       <widget class="QLabel" name="lb_young"><property name="text"><string>Young (Cy)</string></property></widget>
      </item>
      <item row="2" column="3">
       <widget class="QLineEdit" name="edit_young">
        <property name="toolTip"><string>Young's modulus in N/m2 [7.0e10]</string></property>
       </widget>
      </item>
      <item row="3" column="0" colspan="2">
       <widget class="QCheckBox" name="chk_hkm">
        <property name="toolTip"><string>Horizontal distances in the files are in km (Mh) [metres]</string></property>
        <property name="text"><string>x distances in km</string></property>
       </widget>
      </item>
      <item row="3" column="2" colspan="3">
       <widget class="QCheckBox" name="chk_vkm">
        <property name="toolTip"><string>Vertical deflections are in km (Mv) [metres]</string></property>
        <property name="text"><string>deflections in km</string></property>
       </widget>
      </item>
      <item row="4" column="0" colspan="2">
       <widget class="QCheckBox" name="chk_varrestore">
        <property name="toolTip"><string>Restoring force follows the sign of the flexure (L) [constant]</string></property>
        <property name="text"><string>Variable restoring force</string></property>
       </widget>
      </item>
      <item row="4" column="2" colspan="3">
       <widget class="QCheckBox" name="chk_curvature">
        <property name="toolTip"><string>Report the curvature alongside the deflection (S)</string></property>
        <property name="text"><string>Also report the curvature</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QGridLayout" name="gridLayout_out">
     <item row="0" column="0">
      <widget class="QLabel" name="lb_out"><property name="text"><string>Save profile to</string></property></widget>
     </item>
     <item row="0" column="1">
      <widget class="QLineEdit" name="edit_outfile">
       <property name="toolTip"><string>Optional output table. The profile always goes to the Data Viewer.</string></property>
      </widget>
     </item>
     <item row="0" column="2">
      <widget class="QToolButton" name="btn_outfile"><property name="text"><string>...</string></property></widget>
     </item>
     <item row="1" column="0" colspan="3">
      <widget class="QCheckBox" name="chk_plot">
       <property name="toolTip"><string>Also draw the deflection (and the curvature) in the X,Y plot tool</string></property>
       <property name="text"><string>Plot the profile</string></property>
       <property name="checked"><bool>true</bool></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <spacer name="verticalSpacer_bottom">
     <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
     <property name="sizeType"><enum>QSizePolicy::Policy::Fixed</enum></property>
     <property name="sizeHint" stdset="0"><size><width>20</width><height>6</height></size></property>
    </spacer>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_buttons">
     <item>
      <spacer name="buttonsSpacer">
       <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="push_compute">
       <property name="minimumSize"><size><width>90</width><height>24</height></size></property>
       <property name="text"><string>Compute</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="push_close">
       <property name="minimumSize"><size><width>70</width><height>24</height></size></property>
       <property name="text"><string>Close</string></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
