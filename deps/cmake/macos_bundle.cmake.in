# Bundle dependencies from the linked Mach-O files; do not duplicate VTK or Qt module lists here.
# The macOS twin of linux_bundle.cmake.in, and deliberately the same shape: this script only COPIES
# (the resolver decides WHAT), while deps/build_mac.sh does the install-name rewriting and the
# ad-hoc codesign afterwards -- exactly the split build.sh/linux_bundle.cmake.in already use with
# patchelf. One difference is unavoidable and is the whole reason this file is not a copy of the
# Linux one: on macOS Qt is installed as FRAMEWORKS (Homebrew's qtbase symlinks lib/*.framework),
# whose install names are @rpath/QtCore.framework/Versions/A/QtCore -- a path SUFFIX, not a bare
# filename. Flattening those into the bundle root the way a .so is flattened produces a bundle that
# dyld cannot resolve, so the framework-relative subpath is preserved below.
set(_prefix @GMTVTK_MACOS_PREFIX@)

# Qt plugins are loaded at runtime, so nothing links them and the dependency scan cannot see them
# -- they have to be named. Homebrew puts them in share/qt/plugins (INSTALL_DATADIR=share/qt); the
# other two roots cover a Conda/qt6-main or a hand-built Qt, so this file does not care which of
# them provided the Qt that find_package found.
set(_plugin_roots
  ${_prefix}/share/qt/plugins
  ${_prefix}/opt/qtbase/share/qt/plugins
  ${_prefix}/lib/qt6/plugins)
set(_plugins)
foreach(_root IN LISTS _plugin_roots)
  if(IS_DIRECTORY ${_root})
    set(_plugin_patterns
      platforms/libqcocoa.dylib
      styles/libqmacstyle.dylib
      imageformats/libqgif.dylib
      imageformats/libqico.dylib
      imageformats/libqjpeg.dylib
      imageformats/libqsvg.dylib)
    foreach(_pattern IN LISTS _plugin_patterns)
      file(GLOB _found LIST_DIRECTORIES false ${_root}/${_pattern})
      foreach(_plugin IN LISTS _found)
        file(RELATIVE_PATH _relative ${_root} ${_plugin})
        get_filename_component(_subdir ${_relative} DIRECTORY)
        file(INSTALL ${_plugin} DESTINATION ${CMAKE_INSTALL_PREFIX}/plugins/${_subdir}
             FOLLOW_SYMLINK_CHAIN)
        list(APPEND _plugins ${_plugin})
      endforeach()
    endforeach()
    break()
  endif()
endforeach()
if(NOT _plugins)
  message(FATAL_ERROR No_Qt_plugins_found_under:${_plugin_roots})
endif()

# /System and /usr/lib are the OS: libSystem, libc++, and every Apple framework (OpenGL, Cocoa,
# Metal) live there, they are present on every Mac, and they are NOT redistributable. This is the
# macOS counterpart of the Linux script's ^/lib/ ^/usr/lib/ excludes -- and it is also why there is
# no .host_requires here: macOS has no GLVND split, the GPU entry points ARE system frameworks, so
# there is nothing the user could be told to install.
file(GET_RUNTIME_DEPENDENCIES
  LIBRARIES ${CMAKE_INSTALL_PREFIX}/libgmtvtk.dylib ${_plugins}
  RESOLVED_DEPENDENCIES_VAR _resolved
  UNRESOLVED_DEPENDENCIES_VAR _unresolved
  CONFLICTING_DEPENDENCIES_PREFIX _conflict
  DIRECTORIES ${_prefix}/lib ${_prefix}/opt/vtk/lib ${_prefix}/opt/qtbase/lib ${_prefix}/opt/tbb/lib
  POST_EXCLUDE_REGEXES ^/System/ ^/usr/lib/)

# A framework dependency resolves to <root>/QtCore.framework/Versions/A/QtCore, and its install
# name is @rpath/QtCore.framework/Versions/A/QtCore -- so the bundle must reproduce everything from
# the .framework component onward, or dyld looks for a path that is not there. Info.plist rides
# along because `codesign` (run by build_mac.sh, and mandatory on arm64) rejects a framework that
# has no bundle identifier. Headers/ and the .tbd stubs are left behind: nothing reads them.
#
# The Versions/Current symlink is NOT optional, and used to be skipped here on the grounds that
# "nothing at run time reads them" -- true of dyld, which follows the install name straight to
# Versions/A/QtGui, and false of `codesign`. codesign resolves a versioned framework THROUGH
# Versions/Current, so without it the whole directory is not a bundle at all and signing dies with
# "QtGui.framework: bundle format unrecognized, invalid, or unsuitable" -- which on arm64, where an
# unsigned image will not load, stops the build (it did, 2026-08-30). A framework is built complete
# HERE rather than repaired later, so build_mac.sh can sign what it is handed.
function(_igmt_install_dep _dep)
  # Homebrew's Qt frameworks reference each other RELATIVELY, so GET_RUNTIME_DEPENDENCIES hands
  # back chains like
  #   .../QtOpenGLWidgets.framework/Versions/A/../../../QtDBus.framework/Versions/A/QtDBus
  # where the FIRST .framework names whoever did the referencing and the LAST names the library
  # actually being installed. Anchoring at $ with slash-free components matches only that last one
  # (build_mac.sh's bundle_rel does the same thing with a greedy .*/ in sed). Matching the first
  # instead gave QtDBus a copy of QtOpenGLWidgets's symlinks and no Versions/Current of its own,
  # so codesign rejected it -- "bundle format unrecognized, invalid, or unsuitable", 2026-08-31.
  # The optional Versions/<ver>/ group keeps a flat (unversioned) framework matching too.
  string(REGEX MATCH "[^/]+\\.framework/(Versions/[^/]+/)?[^/]+$" _rel ${_dep})
  if(_rel)
    get_filename_component(_sub ${_rel} DIRECTORY)
    file(INSTALL ${_dep} DESTINATION ${CMAKE_INSTALL_PREFIX}/${_sub})
    get_filename_component(_verdir ${_dep} DIRECTORY)
    if(EXISTS ${_verdir}/Resources/Info.plist)
      file(INSTALL ${_verdir}/Resources/Info.plist DESTINATION ${CMAKE_INSTALL_PREFIX}/${_sub}/Resources)
    endif()
    # Only a VERSIONED framework (.framework/Versions/<ver>/<Name>) gets the three symlinks; a flat
    # one is already a valid bundle and its _sub would be the .framework dir itself.
    if(_rel MATCHES "^([^/]+)\\.framework/Versions/([^/]+)/")
      set(_fwname ${CMAKE_MATCH_1})                                   # QtGui
      set(_ver    ${CMAKE_MATCH_2})                                   # A
      set(_fwroot ${CMAKE_INSTALL_PREFIX}/${_fwname}.framework)
      file(REMOVE ${_fwroot}/Versions/Current ${_fwroot}/${_fwname} ${_fwroot}/Resources)
      file(CREATE_LINK ${_ver} ${_fwroot}/Versions/Current SYMBOLIC)
      file(CREATE_LINK Versions/Current/${_fwname} ${_fwroot}/${_fwname} SYMBOLIC)
      if(EXISTS ${_fwroot}/Versions/${_ver}/Resources)
        file(CREATE_LINK Versions/Current/Resources ${_fwroot}/Resources SYMBOLIC)
      endif()
    endif()
  else()
    file(INSTALL ${_dep} DESTINATION ${CMAKE_INSTALL_PREFIX} FOLLOW_SYMLINK_CHAIN)
  endif()
endfunction()

foreach(_dep IN LISTS _resolved)
  _igmt_install_dep(${_dep})
endforeach()

foreach(_name IN LISTS _conflict_FILENAMES)
  set(_choices ${_conflict_${_name}})
  list(GET _choices 0 _dep)
  _igmt_install_dep(${_dep})
endforeach()

if(_unresolved)
  list(REMOVE_DUPLICATES _unresolved)
  message(WARNING Unresolved_macOS_runtime_dependencies:${_unresolved})
endif()
